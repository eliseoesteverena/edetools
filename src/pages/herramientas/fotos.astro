---
// src/pages/herramientas/fotos.astro
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Fotos"
  description="Genera un documento imprimible con múltiples fotos distribuidas automáticamente en hojas de tamaño configurable."
  icon="🖼️"
  tags={[
    { label: 'impresión', type: 'print' },
    { label: 'client-side', type: 'web' },
  ]}
>

  <!-- Estilos dinámicos para @page — se actualizan desde JS -->
  <style id="dynamicStyles"></style>

  <div class="tool-wrap">

    <!-- ── Panel de configuración ──────────────────────── -->
    <div class="config-grid">

      <!-- Hoja -->
      <div class="config-card">
        <h2 class="config-card-title">Hoja</h2>

        <div class="field">
          <label for="sheetSelect">
            Tamaño
            <span id="sheetModBadge" class="mod-badge">personalizado</span>
          </label>
          <select id="sheetSelect">
            <option value="A5">A5 (14.8 × 21 cm)</option>
            <option value="A4">A4 (21 × 29.7 cm)</option>
            <option value="23x32" selected>23 × 32 cm</option>
            <option value="Oficio">Oficio (21.6 × 33 cm)</option>
            <option value="A3">A3 (29.7 × 42 cm)</option>
            <option value="SuperA3">Super A3 (32 × 45 cm)</option>
            <option value="32x47.5">32 × 47.5 cm</option>
          </select>
        </div>

        <div class="field-divider"><span>o medida manual</span></div>

        <div class="dim-row">
          <input type="number" id="sheetW" min="5" max="120" step="0.1" value="23" title="Ancho (cm)" />
          <span class="dim-sep">×</span>
          <input type="number" id="sheetH" min="5" max="120" step="0.1" value="32" title="Alto (cm)" />
          <span class="dim-unit">cm</span>
        </div>
        <p class="dim-hint">Ancho × Alto</p>

        <div class="field" style="margin-top: var(--space-3)">
          <label for="marginSelect">Márgenes</label>
          <select id="marginSelect">
            <option value="0.8">0.8 cm</option>
            <option value="1" selected>1 cm</option>
            <option value="1.2">1.2 cm</option>
            <option value="1.5">1.5 cm</option>
          </select>
        </div>
      </div>

      <!-- Fotos -->
      <div class="config-card">
        <h2 class="config-card-title">Fotografías</h2>

        <div class="field">
          <label for="sizeSelect">
            Tamaño de foto
            <span id="photoModBadge" class="mod-badge">personalizado</span>
          </label>
          <select id="sizeSelect">
            <option value="">— Seleccionar —</option>
            <option value="20x25">20 × 25 cm</option>
            <option value="15x21">15 × 21 cm</option>
            <option value="13x18">13 × 18 cm</option>
            <option value="10x15">10 × 15 cm</option>
            <option value="9x13">9 × 13 cm</option>
            <option value="6x8">6 × 8 cm</option>
          </select>
        </div>

        <div class="field-divider"><span>o medida manual</span></div>

        <div class="dim-row">
          <input type="number" id="photoW" min="1" max="100" step="0.5" placeholder="—" title="Ancho (cm)" />
          <span class="dim-sep">×</span>
          <input type="number" id="photoH" min="1" max="100" step="0.5" placeholder="—" title="Alto (cm)" />
          <span class="dim-unit">cm</span>
        </div>
        <p class="dim-hint">Ancho × Alto</p>

        <div class="field" style="margin-top: var(--space-3)">
          <label for="fileInput">Seleccionar fotos</label>
          <input type="file" id="fileInput" multiple accept="image/*" />
        </div>
      </div>

    </div>

    <!-- ── Info / errores ───────────────────────────────── -->
    <div class="info-box" id="infoBox" hidden></div>

    <!-- ── Botón imprimir ───────────────────────────────── -->
    <button class="btn-print" id="printBtn" type="button" disabled>
      Generar e imprimir
    </button>

  </div>

  <!-- Contenedor de impresión (invisible en pantalla) -->
  <div class="print-container" id="printContainer"></div>

</ToolLayout>

<style>
  /* ── Layout ────────────────────────────────────────── */
  .tool-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 56rem;
  }

  .config-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  @media (max-width: 640px) {
    .config-grid { grid-template-columns: 1fr; }
  }

  /* ── Config card ───────────────────────────────────── */
  .config-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .config-card-title {
    font-size: var(--font-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-500);
    margin-bottom: var(--space-1);
  }

  /* ── Fields ─────────────────────────────────────────── */
  .field { display: flex; flex-direction: column; gap: var(--space-1); }

  /* Separador entre preset e inputs manuales */
  .field-divider {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-1) 0;
  }

  .field-divider::before,
  .field-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-gray-200);
  }

  .field-divider span {
    font-size: var(--font-xs);
    color: var(--color-gray-500);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  /* Badge "personalizado" */
  .mod-badge {
    display: none;
    font-size: 0.6rem;
    font-weight: 500;
    padding: 1px 6px;
    border-radius: 1rem;
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
    vertical-align: middle;
  }

  .mod-badge.visible { display: inline; }

  /* Dimensiones manuales */
  .dim-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dim-row input[type="number"] {
    width: 80px;
    flex: 0 0 80px;
    text-align: center;
  }

  .dim-sep  { color: var(--color-gray-500); font-weight: 500; }
  .dim-unit { font-size: var(--font-sm); color: var(--color-gray-500); }
  .dim-hint { font-size: var(--font-xs); color: var(--color-gray-500); font-style: italic; margin: 0; }

  /* ── Info box ────────────────────────────────────────── */
  .info-box {
    padding: var(--space-4);
    border-left: 4px solid var(--color-primary);
    background: var(--color-primary-light);
    border-radius: var(--radius-md);
    font-size: var(--font-sm);
    line-height: 1.8;
    color: var(--color-gray-700);
  }

  .info-box.is-error   { background: #fdecea; border-left-color: var(--color-accent); color: #991b1b; }
  .info-box.is-warning { background: #fef3c7; border-left-color: #f59e0b; color: #92400e; }

  /* ── Botón ───────────────────────────────────────────── */
  .btn-print {
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--font-base);
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, transform 0.1s;
    align-self: flex-start;
  }

  .btn-print:hover:not(:disabled)  { background: #c0303b; }
  .btn-print:active:not(:disabled) { transform: scale(0.98); }

  .btn-print:disabled {
    background: var(--color-gray-200);
    color: var(--color-gray-500);
    cursor: not-allowed;
  }

  /* ── Área de impresión ───────────────────────────────── */
  /* Solo visible al imprimir */
  .print-container { display: none; }

  @media screen { .print-container { display: none !important; } }

  @media print {
    /* Todo el shell de la app desaparece */
    .site-header,
    .breadcrumb-bar,
    .tool-hero,
    .tool-body > .container > .tool-wrap,
    .site-footer { display: none !important; }

    .print-container { display: block !important; }

    .sheet {
      page-break-after: always;
      position: relative;
      margin: 0;
      padding: 0;
    }

    .sheet:last-child { page-break-after: auto; }

    .print-area { position: absolute; }

    .photo {
      position: absolute;
      margin: 0;
      padding: 0;
      border: none;
      overflow: hidden;
    }

    .photo img {
      width: 100%;
      height: 100%;
      display: block;
    }
  }
</style>

<script>
(function () {
  // ── Presets ───────────────────────────────────────────
  const photoPresets: Record<string, {w:number,h:number}> = {
    '20x25': { w: 20,   h: 25   },
    '15x21': { w: 15,   h: 21   },
    '13x18': { w: 13,   h: 18   },
    '10x15': { w: 10,   h: 15   },
    '9x13':  { w: 9,    h: 13   },
    '6x8':   { w: 6,    h: 8    },
  };

  const sheetPresets: Record<string, {w:number,h:number}> = {
    'A5':      { w: 14.8, h: 21   },
    'A4':      { w: 21,   h: 29.7 },
    '23x32':   { w: 23,   h: 32   },
    'Oficio':  { w: 21.6, h: 33   },
    'A3':      { w: 29.7, h: 42   },
    'SuperA3': { w: 32,   h: 45   },
    '32x47.5': { w: 32,   h: 47.5 },
  };

  // ── DOM refs ──────────────────────────────────────────
  const sheetSelect    = document.getElementById('sheetSelect')    as HTMLSelectElement;
  const sheetW         = document.getElementById('sheetW')         as HTMLInputElement;
  const sheetH         = document.getElementById('sheetH')         as HTMLInputElement;
  const sheetModBadge  = document.getElementById('sheetModBadge')  as HTMLSpanElement;
  const marginSelect   = document.getElementById('marginSelect')   as HTMLSelectElement;
  const sizeSelect     = document.getElementById('sizeSelect')     as HTMLSelectElement;
  const photoW         = document.getElementById('photoW')         as HTMLInputElement;
  const photoH         = document.getElementById('photoH')         as HTMLInputElement;
  const photoModBadge  = document.getElementById('photoModBadge')  as HTMLSpanElement;
  const fileInput      = document.getElementById('fileInput')      as HTMLInputElement;
  const printBtn       = document.getElementById('printBtn')       as HTMLButtonElement;
  const infoBox        = document.getElementById('infoBox')        as HTMLDivElement;
  const printContainer = document.getElementById('printContainer') as HTMLDivElement;
  const dynamicStyles  = document.getElementById('dynamicStyles')  as HTMLStyleElement;

  let files: File[] = [];

  // ── Preset matching ────────────────────────────────────
  function matchPreset(presets: Record<string,{w:number,h:number}>, w: number, h: number, tol = 0.05) {
    for (const [key, val] of Object.entries(presets)) {
      if (Math.abs(val.w - w) < tol && Math.abs(val.h - h) < tol) return key;
    }
    return null;
  }

  // ── Sheet: preset → inputs ─────────────────────────────
  sheetSelect.addEventListener('change', () => {
    const p = sheetPresets[sheetSelect.value];
    if (!p) return;
    sheetW.value = String(p.w);
    sheetH.value = String(p.h);
    sheetModBadge.classList.remove('visible');
    updateUI();
  });

  // ── Sheet: inputs → preset ─────────────────────────────
  [sheetW, sheetH].forEach(el => el.addEventListener('input', () => {
    const w = parseFloat(sheetW.value);
    const h = parseFloat(sheetH.value);
    const match = matchPreset(sheetPresets, w, h);
    if (match) {
      sheetSelect.value = match;
      sheetModBadge.classList.remove('visible');
    } else {
      sheetModBadge.classList.add('visible');
    }
    updateUI();
  }));

  // ── Photo: preset → inputs ─────────────────────────────
  sizeSelect.addEventListener('change', () => {
    const p = photoPresets[sizeSelect.value];
    if (p) {
      photoW.value = String(p.w);
      photoH.value = String(p.h);
      photoModBadge.classList.remove('visible');
    } else {
      photoW.value = '';
      photoH.value = '';
      photoModBadge.classList.remove('visible');
    }
    updateUI();
  });

  // ── Photo: inputs → preset ─────────────────────────────
  [photoW, photoH].forEach(el => el.addEventListener('input', () => {
    const w = parseFloat(photoW.value);
    const h = parseFloat(photoH.value);
    if (!w || !h) {
      sizeSelect.value = '';
      photoModBadge.classList.remove('visible');
    } else {
      const match = matchPreset(photoPresets, w, h);
      if (match) {
        sizeSelect.value = match;
        photoModBadge.classList.remove('visible');
      } else {
        sizeSelect.value = '';
        photoModBadge.classList.add('visible');
      }
    }
    updateUI();
  }));

  marginSelect.addEventListener('change', updateUI);

  fileInput.addEventListener('change', e => {
    files = Array.from((e.target as HTMLInputElement).files!);
    updateUI();
  });

  // ── Config ─────────────────────────────────────────────
  function getConfig() {
    const sw = parseFloat(sheetW.value) || 0;
    const sh = parseFloat(sheetH.value) || 0;
    const margin = parseFloat(marginSelect.value);
    const printW = sw - margin * 2;
    const printH = sh - margin * 2;
    const pw = parseFloat(photoW.value) || 0;
    const ph = parseFloat(photoH.value) || 0;
    return { sw, sh, mt: margin, mb: margin, ml: margin, mr: margin, printW, printH, pw, ph };
  }

  // ── Orientación óptima ─────────────────────────────────
  function calculateOrientation(cfg: ReturnType<typeof getConfig>) {
    const vertical = {
      w: Math.min(cfg.pw, cfg.ph), h: Math.max(cfg.pw, cfg.ph),
      cols: Math.floor(cfg.printW / Math.min(cfg.pw, cfg.ph)),
      rows: Math.floor(cfg.printH / Math.max(cfg.pw, cfg.ph)),
      capacity: 0,
    };
    vertical.capacity = vertical.cols * vertical.rows;

    const horizontal = {
      w: Math.max(cfg.pw, cfg.ph), h: Math.min(cfg.pw, cfg.ph),
      cols: Math.floor(cfg.printW / Math.max(cfg.pw, cfg.ph)),
      rows: Math.floor(cfg.printH / Math.min(cfg.pw, cfg.ph)),
      capacity: 0,
    };
    horizontal.capacity = horizontal.cols * horizontal.rows;

    return vertical.capacity >= horizontal.capacity ? vertical : horizontal;
  }

  // ── Validación ─────────────────────────────────────────
  function validate() {
    const cfg = getConfig();
    const errors: string[] = [], warnings: string[] = [];

    if (cfg.sw <= 0 || cfg.sh <= 0)       errors.push('El tamaño de hoja debe ser mayor a 0.');
    if (cfg.printW <= 0 || cfg.printH <= 0) errors.push('Los márgenes exceden el tamaño de hoja.');
    if (cfg.pw <= 0 || cfg.ph <= 0)        errors.push('El tamaño de foto debe ser mayor a 0.');
    if (files.length === 0)                errors.push('Seleccioná al menos una fotografía.');

    let optimal = null, cols = 0, rows = 0, perPage = 0;

    if (errors.length === 0) {
      optimal = calculateOrientation(cfg);
      ({ cols, rows } = optimal);
      perPage = optimal.capacity;

      if (optimal.w > cfg.printW || optimal.h > cfg.printH)
        errors.push('La foto no cabe en el área de impresión.');
      if (cols === 0 || rows === 0)
        errors.push('No cabe ninguna foto en el área de impresión.');

      if (errors.length === 0) {
        const wastedW = cfg.printW - cols * optimal.w;
        const wastedH = cfg.printH - rows * optimal.h;
        const wastedPct = ((wastedW * cfg.printH + wastedH * cfg.printW - wastedW * wastedH) /
          (cfg.printW * cfg.printH)) * 100;
        if (wastedPct > 30)
          warnings.push(`Se desperdicia ${wastedPct.toFixed(1)}% del área de impresión.`);
      }
    }

    return { valid: errors.length === 0, errors, warnings, cfg, cols, rows, perPage, optimal };
  }

  // ── @page dinámico ─────────────────────────────────────
  function updateDynamicStyles() {
    const cfg = getConfig();
    if (cfg.sw <= 0 || cfg.sh <= 0) return;
    dynamicStyles.textContent = `
      @page { size: ${cfg.sw}cm ${cfg.sh}cm; margin: 0; }
      @media print {
        .sheet      { width: ${cfg.sw}cm; height: ${cfg.sh}cm; }
        .print-area { width: ${cfg.printW}cm; height: ${cfg.printH}cm;
                      top: ${cfg.mt}cm; left: ${cfg.ml}cm; }
      }`;
  }

  // ── Actualizar UI ──────────────────────────────────────
  function updateUI() {
    const { valid, errors, warnings, cfg, cols, rows, perPage } = validate();
    printBtn.disabled = !valid;

    if (errors.length > 0) {
      infoBox.className  = 'info-box is-error';
      infoBox.hidden     = false;
      infoBox.innerHTML  = `<strong>Errores</strong><br>${errors.join('<br>')}`;
    } else {
      const totalPages = Math.ceil(files.length / perPage);
      const html = `<strong>Configuración válida</strong><br>
        Hoja: ${cfg.sw} × ${cfg.sh} cm &nbsp;|&nbsp; Área útil: ${cfg.printW.toFixed(1)} × ${cfg.printH.toFixed(1)} cm<br>
        Foto: ${cfg.pw} × ${cfg.ph} cm &nbsp;|&nbsp;
        ${perPage} por página (${cols} col × ${rows} fil)<br>
        ${files.length} foto${files.length !== 1 ? 's' : ''} → ${totalPages} página${totalPages !== 1 ? 's' : ''}
        ${warnings.length ? '<br><br><strong>Atención:</strong><br>' + warnings.join('<br>') : ''}`;
      infoBox.className = warnings.length ? 'info-box is-warning' : 'info-box';
      infoBox.hidden    = false;
      infoBox.innerHTML = html;
    }

    updateDynamicStyles();
  }

  // ── Análisis de imágenes (orientación) ─────────────────
  function analyzeImages(urls: string[]) {
    return Promise.all(urls.map(url => new Promise<{url:string,isSquare:boolean,isHorizontal:boolean}>(resolve => {
      const img = new Image();
      img.onload  = () => resolve({ url, isSquare: img.naturalWidth === img.naturalHeight, isHorizontal: img.naturalWidth > img.naturalHeight });
      img.onerror = () => resolve({ url, isSquare: false, isHorizontal: false });
      img.src = url;
    })));
  }

  // ── Generación de páginas ──────────────────────────────
  async function generatePages() {
    const { cfg, cols, rows, perPage, optimal } = validate();
    printContainer.innerHTML = '';

    const imageUrls = await Promise.all(files.map(file => new Promise<string>((res, rej) => {
      const reader = new FileReader();
      reader.onload  = e => res(e.target!.result as string);
      reader.onerror = rej;
      reader.readAsDataURL(file);
    })));

    const analyzed     = await analyzeImages(imageUrls);
    const totalPages   = Math.ceil(files.length / perPage);
    const optIsVertical = optimal!.h > optimal!.w;

    for (let page = 0; page < totalPages; page++) {
      const sheet     = document.createElement('div');
      sheet.className = 'sheet';
      const printArea = document.createElement('div');
      printArea.className = 'print-area';

      const start = page * perPage;
      const end   = Math.min(start + perPage, files.length);

      for (let i = start; i < end; i++) {
        const idx = i - start;
        const col = idx % cols;
        const row = Math.floor(idx / cols);

        const photoDiv        = document.createElement('div');
        photoDiv.className    = 'photo';
        photoDiv.style.width  = `${optimal!.w}cm`;
        photoDiv.style.height = `${optimal!.h}cm`;
        photoDiv.style.left   = `${col * optimal!.w}cm`;
        photoDiv.style.top    = `${row * optimal!.h}cm`;

        const img = document.createElement('img');
        img.src   = analyzed[i].url;

        const needsRotation = !analyzed[i].isSquare &&
          ((optIsVertical && analyzed[i].isHorizontal) ||
           (!optIsVertical && !analyzed[i].isHorizontal));

        if (needsRotation) {
          photoDiv.style.display         = 'flex';
          photoDiv.style.alignItems      = 'center';
          photoDiv.style.justifyContent  = 'center';
          img.style.transform  = 'rotate(90deg)';
          img.style.width      = `${optimal!.h}cm`;
          img.style.height     = `${optimal!.w}cm`;
          img.style.maxWidth   = 'none';
          img.style.maxHeight  = 'none';
        }

        photoDiv.appendChild(img);
        printArea.appendChild(photoDiv);
      }

      sheet.appendChild(printArea);
      printContainer.appendChild(sheet);
    }

    // Esperar a que todas las imágenes carguen antes de imprimir
    const imgs = printContainer.querySelectorAll('img');
    await Promise.all(Array.from(imgs).map(img => (img as HTMLImageElement).decode().catch(() => {})));
  }

  // ── Botón imprimir ─────────────────────────────────────
  printBtn.addEventListener('click', async () => {
    try {
      printBtn.disabled     = true;
      printBtn.textContent  = 'Generando…';
      await generatePages();
      printBtn.textContent  = 'Generar e imprimir';
      setTimeout(() => {
        window.print();
        printBtn.disabled = false;
        updateUI();
      }, 100);
    } catch (err: any) {
      alert('Error: ' + err.message);
      printBtn.disabled    = false;
      printBtn.textContent = 'Generar e imprimir';
      updateUI();
    }
  });

  // ── Init ───────────────────────────────────────────────
  updateUI();
})();
</script>
