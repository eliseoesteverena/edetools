---
// src/pages/herramientas/fotos.astro
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Fotos"
  description="Distribuí múltiples fotos en hojas de tamaño configurable."
  icon="🖼️"
  mode="upload"
  actionLabel="Configuración"
  tags={[
    { label: 'impresión', type: 'print' },
    { label: 'client-side', type: 'web' },
  ]}
>

  <style id="dynamicStyles"></style>

  <!-- Upload slot -->
  <div slot="upload" class="fotos-upload">
    <label class="fotos-upload-zone" for="fileInput">
      <span class="drop-icon" aria-hidden="true">🖼️</span>
      <p class="drop-text">Seleccioná las fotos a imprimir</p>
      <p class="drop-hint">JPG, PNG, WebP · múltiples archivos</p>
      <input type="file" id="fileInput" multiple accept="image/*" />
    </label>
  </div>

  <!-- Área principal: preview -->
  <div class="fotos-main">
    <section class="preview-panel" aria-label="Previsualización">
      <div class="preview-header">
        <span class="preview-title">Previsualización</span>
        <span class="preview-hint" id="previewHint">Configurá la hoja y el tamaño de foto</span>
      </div>
      <div class="preview-area" id="previewArea">
        <div class="preview-grid-bg">
          <div class="preview-sheet-card" id="previewSheetCard">
            <canvas class="preview-canvas" id="previewCanvas"></canvas>
            <div class="preview-placeholder" id="previewPlaceholder">
              <span>🖼️</span>
              <small>La distribución aparecerá aquí</small>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Sidebar -->
  <div slot="sidebar" class="fotos-sidebar">

    <div class="sb-section-title">Hoja</div>

    <div class="field">
      <label for="sheetSelect">
        Tamaño
        <span id="sheetModBadge" class="mod-badge">personalizado</span>
      </label>
      <select id="sheetSelect">
        <option value="A5">A5 (14.8 × 21 cm)</option>
        <option value="A4">A4 (21 × 29.7 cm)</option>
        <option value="23x32" selected>23 × 32 cm</option>
        <option value="Oficio">Oficio (21.6 × 33 cm)</option>
        <option value="A3">A3 (29.7 × 42 cm)</option>
        <option value="SuperA3">Super A3 (32 × 45 cm)</option>
        <option value="32x47.5">32 × 47.5 cm</option>
      </select>
    </div>

    <div class="field-divider"><span>o medida manual</span></div>
    <div class="dim-row">
      <input type="number" id="sheetW" min="5" max="120" step="0.1" value="23" title="Ancho (cm)" />
      <span class="dim-sep">×</span>
      <input type="number" id="sheetH" min="5" max="120" step="0.1" value="32" title="Alto (cm)" />
      <span class="dim-unit">cm</span>
    </div>
    <p class="dim-hint">Ancho × Alto (cm)</p>

    <div class="field" style="margin-top: var(--space-2)">
      <label for="marginSelect">Márgenes</label>
      <select id="marginSelect">
        <option value="0.8">0.8 cm</option>
        <option value="1" selected>1 cm</option>
        <option value="1.2">1.2 cm</option>
        <option value="1.5">1.5 cm</option>
      </select>
    </div>

    <div class="sb-divider"></div>
    <div class="sb-section-title">Fotografías</div>

    <div class="field">
      <label for="sizeSelect">
        Tamaño de foto
        <span id="photoModBadge" class="mod-badge">personalizado</span>
      </label>
      <select id="sizeSelect">
        <option value="">— Seleccionar —</option>
        <option value="20x25">20 × 25 cm</option>
        <option value="15x21">15 × 21 cm</option>
        <option value="13x18">13 × 18 cm</option>
        <option value="10x15">10 × 15 cm</option>
        <option value="9x13">9 × 13 cm</option>
        <option value="6x8">6 × 8 cm</option>
      </select>
    </div>

    <div class="field-divider"><span>o medida manual</span></div>
    <div class="dim-row">
      <input type="number" id="photoW" min="1" max="100" step="0.5" placeholder="—" title="Ancho (cm)" />
      <span class="dim-sep">×</span>
      <input type="number" id="photoH" min="1" max="100" step="0.5" placeholder="—" title="Alto (cm)" />
      <span class="dim-unit">cm</span>
    </div>
    <p class="dim-hint">Ancho × Alto (cm)</p>

    <div class="sb-divider"></div>

    <div class="field">
      <label class="btn-change-photos" for="fileInputMore">
        Cambiar fotos
        <input type="file" id="fileInputMore" multiple accept="image/*" />
      </label>
    </div>

    <div class="sb-divider"></div>

    <div class="info-box" id="infoBox" hidden></div>

    <button class="btn-download" id="downloadBtn" type="button" disabled>
      Descargar PDF
    </button>

  </div>

  <div class="print-container" id="printContainer"></div>

</ToolLayout>

<style>
  .fotos-upload { width: 100%; max-width: 400px; margin: 0 auto; }
  .fotos-upload-zone {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
    border: 2px dashed var(--color-gray-200); border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6); text-align: center; cursor: pointer;
    background: var(--color-white); transition: border-color 0.2s, background 0.2s;
    position: relative; margin-bottom: 0;
  }
  .fotos-upload-zone:hover { border-color: var(--color-primary); background: var(--color-primary-light); }
  .fotos-upload-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop-icon { font-size: 2rem; }
  .drop-text { font-size: var(--font-base); color: var(--color-gray-700); margin-bottom: 0; font-weight: 500; }
  .drop-hint { font-size: var(--font-xs); color: var(--color-gray-500); margin-bottom: 0; }

  .fotos-main { display: flex; flex-direction: column; height: 100%; }
  .preview-panel {
    flex: 1; background: var(--color-white); border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column;
  }
  .preview-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-gray-200);
    background: var(--color-gray-50);
  }
  .preview-title { font-size: var(--font-sm); font-weight: 600; color: var(--color-gray-700); }
  .preview-hint  { font-size: var(--font-xs); color: var(--color-gray-500); }
  .preview-area {
    flex: 1; overflow: auto; display: flex; align-items: center; justify-content: center;
    padding: var(--space-6); min-height: 300px;
  }
  .preview-grid-bg {
    width: 100%; height: 100%; min-height: 280px;
    display: flex; align-items: center; justify-content: center;
    background-color: #f0f2f5;
    background-image:
      linear-gradient(to right, #d5d8de 1px, transparent 1px),
      linear-gradient(to bottom, #d5d8de 1px, transparent 1px);
    background-size: 20px 20px;
    border-radius: var(--radius-md); padding: var(--space-6);
  }
  .preview-sheet-card {
    background: #fff;
    box-shadow: 0 4px 24px 0 rgba(0,0,0,0.18), 0 1px 4px 0 rgba(0,0,0,0.08);
    border-radius: 2px; position: relative;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; width: 220px; height: 308px; flex-shrink: 0;
  }
  .preview-canvas { width: 100%; height: 100%; display: block; }
  .preview-placeholder {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-2); color: var(--color-gray-500); pointer-events: none;
  }
  .preview-placeholder span { font-size: 2.5rem; opacity: 0.3; }
  .preview-placeholder small { font-size: var(--font-xs); }

  .fotos-sidebar { display: flex; flex-direction: column; gap: var(--space-3); }
  .sb-section-title {
    font-size: var(--font-xs); font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--color-gray-500);
  }
  .sb-divider { height: 1px; background: var(--color-gray-200); margin: var(--space-1) 0; }
  .field { display: flex; flex-direction: column; gap: var(--space-1); }
  .field label {
    font-size: var(--font-xs); font-weight: 500; color: var(--color-gray-700);
    display: flex; align-items: center; gap: var(--space-1); margin-bottom: 0;
  }
  .mod-badge {
    display: none; font-size: 0.6rem; font-weight: 500; padding: 1px 6px;
    border-radius: 1rem; background: #fef3c7; color: #92400e; border: 1px solid #fcd34d;
  }
  .mod-badge.visible { display: inline; }
  .field-divider { display: flex; align-items: center; gap: var(--space-2); margin: var(--space-1) 0; }
  .field-divider::before, .field-divider::after { content: ''; flex: 1; height: 1px; background: var(--color-gray-200); }
  .field-divider span {
    font-size: var(--font-xs); color: var(--color-gray-500);
    white-space: nowrap; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500;
  }
  .dim-row { display: flex; align-items: center; gap: var(--space-2); }
  .dim-row input[type="number"] { width: 70px; flex: 0 0 70px; text-align: center; }
  .dim-sep  { color: var(--color-gray-500); font-weight: 500; }
  .dim-unit { font-size: var(--font-xs); color: var(--color-gray-500); }
  .dim-hint { font-size: var(--font-xs); color: var(--color-gray-500); font-style: italic; margin: 0; }
  .btn-change-photos {
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-2) var(--space-3); background: var(--color-white);
    color: var(--color-primary); border: 1px dashed var(--color-primary);
    border-radius: var(--radius-md); font-size: var(--font-sm); font-weight: 500;
    cursor: pointer; width: 100%; position: relative; transition: background 0.15s; margin-bottom: 0;
  }
  .btn-change-photos:hover { background: var(--color-primary-light); }
  .btn-change-photos input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .info-box {
    padding: var(--space-4); border-left: 4px solid var(--color-primary);
    background: var(--color-primary-light); border-radius: var(--radius-md);
    font-size: var(--font-sm); line-height: 1.8; color: var(--color-gray-700);
  }
  .info-box.is-error   { background: #fdecea; border-left-color: var(--color-accent); color: #991b1b; }
  .info-box.is-warning { background: #fef3c7; border-left-color: #f59e0b; color: #92400e; }
  .btn-download {
    padding: var(--space-3) var(--space-6); background: var(--color-accent);
    color: #fff; border: none; border-radius: var(--radius-md);
    font-size: var(--font-base); font-weight: 600; font-family: inherit;
    cursor: pointer; transition: background 0.2s; width: 100%;
  }
  .btn-download:hover:not(:disabled) { background: #c0303b; }
  .btn-download:disabled { background: var(--color-gray-200); color: var(--color-gray-500); cursor: not-allowed; }
  .print-container { display: none !important; }
</style>

<script>
(function () {
  const photoPresets = {
    '20x25': { w: 20, h: 25 }, '15x21': { w: 15, h: 21 },
    '13x18': { w: 13, h: 18 }, '10x15': { w: 10, h: 15 },
    '9x13':  { w: 9,  h: 13 }, '6x8':   { w: 6,  h: 8  },
  };
  const sheetPresets = {
    'A5':      { w: 14.8, h: 21   }, 'A4':      { w: 21,   h: 29.7 },
    '23x32':   { w: 23,   h: 32   }, 'Oficio':  { w: 21.6, h: 33   },
    'A3':      { w: 29.7, h: 42   }, 'SuperA3': { w: 32,   h: 45   },
    '32x47.5': { w: 32,   h: 47.5 },
  };

  const sheetSelect       = document.getElementById('sheetSelect');
  const sheetW            = document.getElementById('sheetW');
  const sheetH            = document.getElementById('sheetH');
  const sheetModBadge     = document.getElementById('sheetModBadge');
  const marginSelect      = document.getElementById('marginSelect');
  const sizeSelect        = document.getElementById('sizeSelect');
  const photoW            = document.getElementById('photoW');
  const photoH            = document.getElementById('photoH');
  const photoModBadge     = document.getElementById('photoModBadge');
  const fileInput         = document.getElementById('fileInput');
  const fileInputMore     = document.getElementById('fileInputMore');
  const downloadBtn       = document.getElementById('downloadBtn');
  const infoBox           = document.getElementById('infoBox');
  const previewCanvas     = document.getElementById('previewCanvas');
  const previewSheetCard  = document.getElementById('previewSheetCard');
  const previewPlaceholder= document.getElementById('previewPlaceholder');
  const previewHint       = document.getElementById('previewHint');

  let files = [];
  let analyzedImages = [];  // { element: HTMLImageElement, isHorizontal, isSquare }

  // ── Helpers ───────────────────────────────────────────
  function matchPreset(presets, w, h, tol = 0.05) {
    for (const [key, val] of Object.entries(presets))
      if (Math.abs(val.w - w) < tol && Math.abs(val.h - h) < tol) return key;
    return null;
  }

  function getConfig() {
    const sw = parseFloat(sheetW.value) || 0;
    const sh = parseFloat(sheetH.value) || 0;
    const margin = parseFloat(marginSelect.value);
    const pw = parseFloat(photoW.value) || 0;
    const ph = parseFloat(photoH.value) || 0;
    return { sw, sh, margin, printW: sw - margin * 2, printH: sh - margin * 2, pw, ph };
  }

  // Devuelve el objeto optimal con .isVerticalSlot indicando que slot.h >= slot.w
  function calculateOrientation(cfg) {
    const v = { w: Math.min(cfg.pw, cfg.ph), h: Math.max(cfg.pw, cfg.ph), isVerticalSlot: true };
    v.cols = Math.floor(cfg.printW / v.w);
    v.rows = Math.floor(cfg.printH / v.h);
    v.capacity = v.cols * v.rows;

    const hz = { w: Math.max(cfg.pw, cfg.ph), h: Math.min(cfg.pw, cfg.ph), isVerticalSlot: false };
    hz.cols = Math.floor(cfg.printW / hz.w);
    hz.rows = Math.floor(cfg.printH / hz.h);
    hz.capacity = hz.cols * hz.rows;

    return v.capacity >= hz.capacity ? v : hz;
  }

  function validate() {
    const cfg = getConfig();
    const errors = [], warnings = [];
    if (cfg.sw <= 0 || cfg.sh <= 0)         errors.push('El tamano de hoja debe ser mayor a 0.');
    if (cfg.printW <= 0 || cfg.printH <= 0) errors.push('Los margenes exceden el tamano de hoja.');
    if (cfg.pw <= 0 || cfg.ph <= 0)         errors.push('El tamano de foto debe ser mayor a 0.');
    if (files.length === 0)                 errors.push('Selecciona al menos una fotografia.');

    let optimal = null, cols = 0, rows = 0, perPage = 0;
    if (errors.length === 0) {
      optimal = calculateOrientation(cfg);
      ({ cols, rows } = optimal);
      perPage = optimal.capacity;
      if (optimal.w > cfg.printW || optimal.h > cfg.printH)
        errors.push('La foto no cabe en el area de impresion.');
      if (cols === 0 || rows === 0)
        errors.push('No cabe ninguna foto en el area de impresion.');
      if (errors.length === 0) {
        const wp = cfg.printW - cols * optimal.w;
        const hp = cfg.printH - rows * optimal.h;
        const wasted = ((wp * cfg.printH + hp * cfg.printW - wp * hp) / (cfg.printW * cfg.printH)) * 100;
        if (wasted > 30) warnings.push('Se desperdicia ' + wasted.toFixed(1) + '% del area de impresion.');
      }
    }
    return { valid: errors.length === 0, errors, warnings, cfg, cols, rows, perPage, optimal };
  }

  // Una imagen necesita rotar si su orientacion no coincide con el slot
  function imageNeedsRotation(img, optimal) {
    if (img.isSquare) return false;
    return optimal.isVerticalSlot ? img.isHorizontal : !img.isHorizontal;
  }

  // ── Preview canvas ────────────────────────────────────
  const MAX_W = 220, MAX_H = 400;

  function updatePreview() {
    const { valid, errors, warnings, cfg, cols, rows, perPage, optimal } = validate();

    if (errors.length > 0) {
      infoBox.className = 'info-box is-error'; infoBox.hidden = false;
      infoBox.innerHTML = '<strong>Errores</strong><br>' + errors.join('<br>');
    } else {
      const tp = Math.ceil(files.length / perPage);
      infoBox.className = warnings.length ? 'info-box is-warning' : 'info-box'; infoBox.hidden = false;
      infoBox.innerHTML = '<strong>Configuracion valida</strong><br>' +
        'Hoja: ' + cfg.sw + ' x ' + cfg.sh + ' cm &nbsp;|&nbsp; Area util: ' + cfg.printW.toFixed(1) + ' x ' + cfg.printH.toFixed(1) + ' cm<br>' +
        'Foto: ' + cfg.pw + ' x ' + cfg.ph + ' cm &nbsp;|&nbsp; ' + perPage + ' por pagina (' + cols + ' col x ' + rows + ' fil)<br>' +
        files.length + ' foto' + (files.length !== 1 ? 's' : '') + ' -> ' + tp + ' pagina' + (tp !== 1 ? 's' : '') +
        (warnings.length ? '<br><br><strong>Atencion:</strong><br>' + warnings.join('<br>') : '');
    }
    downloadBtn.disabled = !valid;
    if (!cfg.sw || !cfg.sh) return;

    const aspect = cfg.sw / cfg.sh;
    let cw, ch;
    if (aspect >= 1) {
      cw = MAX_W; ch = Math.round(MAX_W / aspect);
      if (ch > MAX_H) { ch = MAX_H; cw = Math.round(MAX_H * aspect); }
    } else {
      ch = MAX_H; cw = Math.round(MAX_H * aspect);
      if (cw > MAX_W) { cw = MAX_W; ch = Math.round(MAX_W / aspect); }
    }
    previewSheetCard.style.width  = cw + 'px';
    previewSheetCard.style.height = ch + 'px';
    previewCanvas.style.width     = cw + 'px';
    previewCanvas.style.height    = ch + 'px';

    const dpr = window.devicePixelRatio || 1;
    previewCanvas.width  = cw * dpr;
    previewCanvas.height = ch * dpr;
    const ctx = previewCanvas.getContext('2d');
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, cw, ch);
    ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, cw, ch);

    if (!valid || !optimal) {
      previewPlaceholder.style.display = '';
      if (previewHint) previewHint.textContent = 'Configura la hoja y el tamano de foto';
      return;
    }
    previewPlaceholder.style.display = 'none';

    const scale = cw / cfg.sw;
    const mPx   = cfg.margin * scale;
    const slotW = optimal.w * scale;
    const slotH = optimal.h * scale;

    ctx.strokeStyle = '#e0e4ea'; ctx.lineWidth = 0.5; ctx.setLineDash([3, 3]);
    ctx.strokeRect(mPx, mPx, cfg.printW * scale, cfg.printH * scale);
    ctx.setLineDash([]);

    const count = Math.min(analyzedImages.length || (cols * rows), cols * rows);
    for (let i = 0; i < count; i++) {
      const col = i % cols, row = Math.floor(i / cols);
      const x = mPx + col * slotW, y = mPx + row * slotH;
      const img = analyzedImages[i];

      if (img && img.element) {
        const rot = imageNeedsRotation(img, optimal);
        ctx.save();
        ctx.beginPath(); ctx.rect(x, y, slotW, slotH); ctx.clip();
        if (rot) {
          ctx.translate(x + slotW / 2, y + slotH / 2);
          ctx.rotate(Math.PI / 2);
          const imgAsp = img.element.naturalWidth / img.element.naturalHeight;
          const sAsp   = slotH / slotW;
          let dw, dh;
          if (imgAsp > sAsp) { dh = slotW; dw = slotW * imgAsp; }
          else               { dw = slotH; dh = slotH / imgAsp; }
          ctx.drawImage(img.element, -dw / 2, -dh / 2, dw, dh);
        } else {
          const imgAsp = img.element.naturalWidth / img.element.naturalHeight;
          const sAsp   = slotW / slotH;
          let dw = slotW, dh = slotH, dx = x, dy = y;
          if (imgAsp > sAsp) { dh = slotH; dw = slotH * imgAsp; dx = x - (dw - slotW) / 2; }
          else               { dw = slotW; dh = slotW / imgAsp; dy = y - (dh - slotH) / 2; }
          ctx.drawImage(img.element, dx, dy, dw, dh);
        }
        ctx.restore();
      } else {
        ctx.fillStyle = '#f0f2f5'; ctx.fillRect(x, y, slotW - 0.5, slotH - 0.5);
        ctx.strokeStyle = '#c8cdd6'; ctx.lineWidth = 0.5; ctx.strokeRect(x, y, slotW - 0.5, slotH - 0.5);
        ctx.fillStyle = '#b0b8c4'; ctx.font = Math.max(8, slotW * 0.3) + 'px sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText('XX', x + slotW / 2, y + slotH / 2);
      }
    }

    if (previewHint) {
      const tp = Math.ceil((files.length || 1) / (cols * rows));
      previewHint.textContent = (cols * rows) + ' por pag. | ' + files.length + ' fotos -> ' + tp + ' pag' + (tp !== 1 ? 's' : '') + ' (pag. 1)';
    }
  }

  // ── Carga de imagenes ─────────────────────────────────
  async function loadImages(newFiles) {
    analyzedImages = await Promise.all(Array.from(newFiles).map(function(f) {
      return new Promise(function(res) {
        const r = new FileReader();
        r.onload = function() {
          const img = new Image();
          img.onload  = function() { res({ element: img, isSquare: img.naturalWidth === img.naturalHeight, isHorizontal: img.naturalWidth > img.naturalHeight }); };
          img.onerror = function() { res({ element: null, isSquare: false, isHorizontal: false }); };
          img.src = r.result;
        };
        r.readAsDataURL(f);
      });
    }));
    updatePreview();
  }

  // ── Constantes de conversión ─────────────────────────
  var CM_TO_PT  = 72 / 2.54;   // 1 cm = ~28.35 pt
  var PX_PER_CM = 150 / 2.54;  // resolución de render: 150 dpi

  // ── Canvas offscreen: rota + recorta (cover) al slot ──
  // Devuelve Uint8Array PNG via canvas.toBlob → arrayBuffer.
  // Síncrono en apariencia porque toDataURL es síncrono;
  // se usa toBlob (async) para no saturar la memoria con strings base64 grandes.
  function renderSlotToBlob(imgEl, slotWcm, slotHcm, needsRot) {
    var cw = Math.round(slotWcm * PX_PER_CM);
    var ch = Math.round(slotHcm * PX_PER_CM);
    var cvs = document.createElement('canvas');
    cvs.width = cw; cvs.height = ch;
    var ctx = cvs.getContext('2d');

    if (needsRot) {
      // Rotar 90° CW alrededor del centro del canvas
      ctx.translate(cw / 2, ch / 2);
      ctx.rotate(Math.PI / 2);
      // Tras rotar: el espacio útil es ch×cw (ejes intercambiados)
      var aW = ch, aH = cw;
      var asp = imgEl.naturalWidth / imgEl.naturalHeight;
      var sAsp = aW / aH;
      var dw = asp > sAsp ? aH * asp : aW;
      var dh = asp > sAsp ? aH       : aW / asp;
      ctx.drawImage(imgEl, -dw / 2, -dh / 2, dw, dh);
    } else {
      var asp2 = imgEl.naturalWidth / imgEl.naturalHeight;
      var sAsp2 = cw / ch;
      var dw2, dh2, dx = 0, dy = 0;
      if (asp2 > sAsp2) { dh2 = ch; dw2 = ch * asp2; dx = -(dw2 - cw) / 2; }
      else              { dw2 = cw; dh2 = cw / asp2; dy = -(dh2 - ch) / 2; }
      ctx.drawImage(imgEl, dx, dy, dw2, dh2);
    }

    // toBlob es async y más eficiente en memoria que toDataURL para imágenes grandes
    return new Promise(function(resolve, reject) {
      cvs.toBlob(function(blob) {
        if (!blob) { reject(new Error('canvas.toBlob falló')); return; }
        blob.arrayBuffer().then(function(buf) {
          resolve(new Uint8Array(buf));
        }).catch(reject);
      }, 'image/png');
    });
  }

  // ── Generación de PDF 100% client-side con pdf-lib ────
  // pdf-lib se carga desde CDN (esm.sh) la primera vez que se necesita.
  // No hay fetch al servidor — todo ocurre en el browser del usuario.
  var _pdfLib = null;
  async function getPdfLib() {
    if (_pdfLib) return _pdfLib;
    // esm.sh sirve el módulo ESM de pdf-lib compatible con browsers modernos
    var mod = await import('https://esm.sh/pdf-lib@1.17.1?bundle');
    _pdfLib = mod;
    return mod;
  }

  async function generarPDF(cfg, optimal, cols, rows) {
    var { PDFDocument, rgb } = await getPdfLib();

    var perPage  = cols * rows;
    var total    = analyzedImages.length;
    var numPages = Math.ceil(total / perPage);

    var pageWpt = cfg.sw * CM_TO_PT;
    var pageHpt = cfg.sh * CM_TO_PT;
    var slotWpt = optimal.w * CM_TO_PT;
    var slotHpt = optimal.h * CM_TO_PT;
    var marginPt = cfg.margin * CM_TO_PT;

    var doc = await PDFDocument.create();
    doc.setTitle('Fotos');
    doc.setProducer('edetools / fotos client-side');

    for (var p = 0; p < numPages; p++) {
      var page = doc.addPage([pageWpt, pageHpt]);

      for (var i = p * perPage; i < Math.min((p + 1) * perPage, total); i++) {
        var img  = analyzedImages[i];
        var idx  = i - p * perPage;
        var col  = idx % cols;
        var row  = Math.floor(idx / cols);

        // Posición en pt (origen top-left → convertir a bottom-left de PDF)
        var xPt  = marginPt + col * slotWpt;
        var yPt  = pageHpt - marginPt - (row + 1) * slotHpt;  // PDF: y sube

        if (!img.element) {
          // Placeholder gris si la imagen no cargó
          page.drawRectangle({
            x: xPt, y: yPt, width: slotWpt, height: slotHpt,
            color: rgb(0.85, 0.85, 0.85),
            borderColor: rgb(0.6, 0.6, 0.6), borderWidth: 0.5,
          });
          continue;
        }

        var needsRot = imageNeedsRotation(img, optimal);

        // Renderizar slot en canvas offscreen (rota + recorta a cover)
        var pngBytes;
        try {
          pngBytes = await renderSlotToBlob(img.element, optimal.w, optimal.h, needsRot);
        } catch(e) {
          console.warn('[fotos] renderSlotToBlob falló:', e);
          page.drawRectangle({ x: xPt, y: yPt, width: slotWpt, height: slotHpt, color: rgb(0.85, 0.85, 0.85) });
          continue;
        }

        // Embeber PNG en el PDF (sin rotación — la imagen ya está orientada)
        var pdfImg;
        try {
          pdfImg = await doc.embedPng(pngBytes);
        } catch(e) {
          console.warn('[fotos] embedPng falló:', e);
          page.drawRectangle({ x: xPt, y: yPt, width: slotWpt, height: slotHpt, color: rgb(0.85, 0.85, 0.85) });
          continue;
        }

        page.drawImage(pdfImg, { x: xPt, y: yPt, width: slotWpt, height: slotHpt });
      }
    }

    return doc.save();  // Uint8Array
  }

  // ── Descargar PDF ─────────────────────────────────────
  downloadBtn.addEventListener('click', async function() {
    var result = validate();
    if (!result.valid) return;
    var cfg = result.cfg, cols = result.cols, rows = result.rows, optimal = result.optimal;

    downloadBtn.disabled    = true;
    downloadBtn.textContent = 'Generando PDF…';
    try {
      var pdfBytes = await generarPDF(cfg, optimal, cols, rows);
      var blob = new Blob([pdfBytes], { type: 'application/pdf' });
      var url  = URL.createObjectURL(blob);
      var a    = document.createElement('a');
      a.href = url; a.download = 'fotos.pdf';
      document.body.appendChild(a); a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch(err) {
      console.error('[fotos] generarPDF:', err);
      alert('Error generando el PDF: ' + err.message);
    } finally {
      downloadBtn.disabled    = false;
      downloadBtn.textContent = 'Descargar PDF';
    }
  });

  // ── Listeners ─────────────────────────────────────────
  sheetSelect.addEventListener('change', function() {
    var p = sheetPresets[sheetSelect.value]; if (!p) return;
    sheetW.value = String(p.w); sheetH.value = String(p.h);
    sheetModBadge.classList.remove('visible'); updatePreview();
  });
  [sheetW, sheetH].forEach(function(el) { el.addEventListener('input', function() {
    var m = matchPreset(sheetPresets, parseFloat(sheetW.value), parseFloat(sheetH.value));
    if (m) sheetSelect.value = m;
    sheetModBadge.classList.toggle('visible', !m); updatePreview();
  }); });
  sizeSelect.addEventListener('change', function() {
    var p = photoPresets[sizeSelect.value];
    photoW.value = p ? String(p.w) : ''; photoH.value = p ? String(p.h) : '';
    photoModBadge.classList.remove('visible'); updatePreview();
  });
  [photoW, photoH].forEach(function(el) { el.addEventListener('input', function() {
    var w = parseFloat(photoW.value), h = parseFloat(photoH.value);
    var m = (w && h) ? matchPreset(photoPresets, w, h) : null;
    sizeSelect.value = m || '';
    photoModBadge.classList.toggle('visible', !!(w && h && !m)); updatePreview();
  }); });
  marginSelect.addEventListener('change', updatePreview);

  async function handleFiles(newFiles) {
    files = Array.from(newFiles);
    if (files.length) {
      if (typeof window.toolReady === 'function') window.toolReady();
      await loadImages(files);
    } else { analyzedImages = []; updatePreview(); }
  }
  fileInput.addEventListener('change',   function(e) { handleFiles(e.target.files); });
  if (fileInputMore) fileInputMore.addEventListener('change', function(e) { handleFiles(e.target.files); });

  updatePreview();
})();
</script>
