---
// src/pages/herramientas/contar-paginas.astro
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Contar páginas"
  description="Contá páginas de múltiples PDFs y calculá hojas necesarias."
  icon="🔢"
  mode="upload"
  actionLabel="Opciones"
  tags={[
    { label: 'pdf', type: 'pdf' },
    { label: 'client-side', type: 'web' },
  ]}
>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

  <!-- ── Upload slot ──────────────────────────────────── -->
  <div slot="upload" class="cp-upload">
    <label class="cp-upload-zone" for="fileInput">
      <span class="drop-icon" aria-hidden="true">📄</span>
      <p class="drop-text">Arrastrá tus PDFs aquí o hacé clic para seleccionar</p>
      <p class="drop-hint">Múltiples archivos · cualquier PDF</p>
      <input type="file" id="fileInput" accept="application/pdf" multiple />
    </label>
  </div>

  <!-- ── Área principal (default slot → tl-main) ──────── -->
  <div class="cp-main">

    <!-- Totales globales -->
    <div class="totals" id="totals"></div>

    <!-- Tamaños detectados -->
    <div class="sizes-panel" id="sizesPanel" hidden>
      <p class="section-label">Tamaños detectados</p>
      <div class="sizes-list" id="sizesList"></div>
    </div>

    <!-- Lista de archivos con thumbnails inline -->
    <div class="results" id="results"></div>

  </div>

  <!-- ── Sidebar ───────────────────────────────────────── -->
  <div slot="sidebar" class="cp-sidebar">

    <div class="sb-section-title">Archivos</div>

    <label class="btn-add-files" for="fileInputMore">
      + Agregar más PDFs
      <input type="file" id="fileInputMore" accept="application/pdf" multiple />
    </label>

    <div class="sb-divider"></div>
    <div class="sb-section-title">Impresión</div>

    <fieldset>
      <legend>Páginas por carilla</legend>
      <div class="radio-col">
        <label><input type="radio" name="pagesPerSide" value="1" checked /> 1</label>
        <label><input type="radio" name="pagesPerSide" value="2" /> 2</label>
        <label><input type="radio" name="pagesPerSide" value="4" /> 4</label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Tipo de impresión</legend>
      <div class="radio-col">
        <label><input type="radio" name="printType" value="2" checked /> Doble faz</label>
        <label><input type="radio" name="printType" value="1" /> Simple faz</label>
      </div>
    </fieldset>

  </div>

</ToolLayout>

<style>
  /* ── Upload ─────────────────────────────────────────── */
  .cp-upload { width: 100%; max-width: 400px; margin: 0 auto; }
  .cp-upload-zone {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
    border: 2px dashed var(--color-gray-200); border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6); text-align: center; cursor: pointer;
    background: var(--color-white); transition: border-color 0.2s, background 0.2s;
    position: relative; margin-bottom: 0;
  }
  .cp-upload-zone:hover { border-color: var(--color-primary); background: var(--color-primary-light); }
  .cp-upload-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop-icon  { font-size: 2rem; }
  .drop-text  { font-size: var(--font-base); color: var(--color-gray-700); margin-bottom: 0; font-weight: 500; }
  .drop-hint  { font-size: var(--font-xs); color: var(--color-gray-500); margin-bottom: 0; }

  /* ── Main ───────────────────────────────────────────── */
  .cp-main { display: flex; flex-direction: column; gap: var(--space-4); }

  /* ── Sidebar ────────────────────────────────────────── */
  .cp-sidebar { display: flex; flex-direction: column; gap: var(--space-3); }
  .sb-section-title {
    font-size: var(--font-xs); font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--color-gray-500);
  }
  .sb-divider { height: 1px; background: var(--color-gray-200); margin: var(--space-1) 0; }
  .btn-add-files {
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-2) var(--space-3);
    background: var(--color-white); color: var(--color-primary);
    border: 1px dashed var(--color-primary); border-radius: var(--radius-md);
    font-size: var(--font-sm); font-weight: 500; cursor: pointer;
    width: 100%; position: relative; transition: background 0.15s; margin-bottom: 0;
  }
  .btn-add-files:hover { background: var(--color-primary-light); }
  .btn-add-files input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .cp-sidebar fieldset {
    border: 1px solid var(--color-gray-200); border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4); margin: 0;
  }
  .cp-sidebar legend {
    font-size: var(--font-xs); font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-gray-500); padding: 0 var(--space-1);
  }
  .radio-col { display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-2); }
  .radio-col label { display: flex; align-items: center; gap: var(--space-2); font-size: var(--font-sm); font-weight: 400; cursor: pointer; margin: 0; }
  .radio-col input[type="radio"] { width: auto; cursor: pointer; }

  /* ── Totales ────────────────────────────────────────── */
  .totals { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .totals > * { flex: 1; min-width: 72px; }

  /* ── Tamaños ────────────────────────────────────────── */
  .section-label {
    font-size: var(--font-xs); font-weight: 600; color: var(--color-gray-500);
    text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-2);
  }
  .sizes-panel {
    background: var(--color-gray-50); border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md); padding: var(--space-3) var(--space-4);
  }
  .sizes-list { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .size-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: var(--font-xs); font-weight: 600;
    padding: 0.15rem 0.5rem; border-radius: 2rem; white-space: nowrap;
  }
  .size-badge .count { background: rgba(0,0,0,0.1); border-radius: 1rem; padding: 0 5px; font-weight: 400; }
  .sz-a3     { background: #e3f2fd; color: #1565c0; }
  .sz-a4     { background: #e8f5e9; color: #2e7d32; }
  .sz-a5     { background: #fff3e0; color: #e65100; }
  .sz-letter { background: #fce4ec; color: #880e4f; }
  .sz-other  { background: #f3e5f5; color: #6a1b9a; }
  .size-pill { font-size: 0.6rem; font-weight: 600; padding: 1px 5px; border-radius: 1rem; white-space: nowrap; }

  /* ── Results ────────────────────────────────────────── */
  .results { display: flex; flex-direction: column; gap: var(--space-3); }

  /* Tarjeta horizontal: thumbnail | info */
  .result-card {
    display: flex; align-items: stretch;
    background: var(--color-white); border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg); overflow: hidden;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .result-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.09); border-color: var(--color-primary); }
  .result-card.is-error { border-color: #f5c6cb; background: #fdecea; }

  /* Columna izquierda: canvas */
  .result-thumb {
    flex-shrink: 0; width: 90px;
    background: var(--color-gray-100);
    border-right: 1px solid var(--color-gray-200);
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .result-thumb canvas {
    width: 100%; height: 100%; object-fit: contain; display: block;
  }
  .result-thumb-loading {
    font-size: var(--font-xs); color: var(--color-gray-500); text-align: center; padding: var(--space-2);
  }
  .result-thumb-error {
    font-size: 1.8rem; display: flex; align-items: center; justify-content: center;
    width: 100%; height: 100%; min-height: 100px;
  }

  /* Columna derecha: info */
  .result-info {
    flex: 1; min-width: 0;
    padding: var(--space-3) var(--space-4);
    display: flex; flex-direction: column; gap: var(--space-1); justify-content: center;
  }
  .result-name {
    font-size: var(--font-sm); font-weight: 600; color: var(--color-gray-900);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 2px;
  }
  .result-pages-big {
    font-size: var(--font-xl); font-weight: 700; color: var(--color-primary); line-height: 1;
  }
  .result-sheets-row { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-1); }
  .result-size-row   { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: 2px; }
</style>

<script>
(function () {
  // @ts-ignore
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

  const fileInput  = document.getElementById('fileInput')  as HTMLInputElement;
  const totalsEl   = document.getElementById('totals')     as HTMLDivElement;
  const sizesPanel = document.getElementById('sizesPanel') as HTMLDivElement;
  const sizesList  = document.getElementById('sizesList')  as HTMLDivElement;
  const resultsEl  = document.getElementById('results')    as HTMLDivElement;

  type PdfEntry = {
    name: string; pages: number; pageSizes: Record<string, number>;
    error?: boolean; pdfDoc?: any;
  };
  let pdfData: PdfEntry[] = [];

  fileInput.addEventListener('change', e => {
    pdfData = [];
    resultsEl.innerHTML = '';
    handleFiles((e.target as HTMLInputElement).files!);
  });

  const fileInputMore = document.getElementById('fileInputMore') as HTMLInputElement;
  if (fileInputMore) fileInputMore.addEventListener('change', e =>
    handleFiles((e.target as HTMLInputElement).files!)
  );

  function classifySize(wMM: number, hMM: number): string {
    const w = Math.min(wMM, hMM), h = Math.max(wMM, hMM), tol = 5;
    const sizes = [
      { name: 'A0', w: 841, h: 1189 }, { name: 'A1', w: 594, h: 841 },
      { name: 'A2', w: 420, h: 594  }, { name: 'A3', w: 297, h: 420 },
      { name: 'A4', w: 210, h: 297  }, { name: 'A5', w: 148, h: 210 },
      { name: 'A6', w: 105, h: 148  }, { name: 'Carta', w: 216, h: 279 },
      { name: 'Legal', w: 216, h: 356 }, { name: 'Oficio', w: 216, h: 330 },
      { name: 'Tabloide', w: 279, h: 432 },
    ];
    for (const s of sizes) {
      if (Math.abs(w - s.w) <= tol && Math.abs(h - s.h) <= tol) return s.name;
    }
    return `${wMM}×${hMM}mm`;
  }

  function getSizeClass(name: string): string {
    if (['A0','A1','A2','A3','Tabloide'].includes(name)) return 'sz-a3';
    if (name === 'A4')                                    return 'sz-a4';
    if (['A5','A6'].includes(name))                       return 'sz-a5';
    if (['Carta','Legal','Oficio'].includes(name))        return 'sz-letter';
    return 'sz-other';
  }

  async function handleFiles(files: FileList) {
    const valid = Array.from(files).filter(f => f.type === 'application/pdf');
    if (!valid.length) return;

    for (const file of valid) {
      const ab = await file.arrayBuffer();
      try {
        // @ts-ignore
        const pdf = await pdfjsLib.getDocument(new Uint8Array(ab)).promise;
        const pageSizes: Record<string, number> = {};
        for (let i = 1; i <= pdf.numPages; i++) {
          const page = await pdf.getPage(i);
          const vp   = page.getViewport({ scale: 1 });
          const wMM  = Math.round(vp.width  * 25.4 / 72);
          const hMM  = Math.round(vp.height * 25.4 / 72);
          const sz   = classifySize(wMM, hMM);
          pageSizes[sz] = (pageSizes[sz] || 0) + 1;
        }
        pdfData.push({ name: file.name, pages: pdf.numPages, pageSizes, pdfDoc: pdf });
      } catch {
        pdfData.push({ name: file.name, pages: 0, pageSizes: {}, error: true });
      }
    }

    renderAll();
  }

  // Construye y agrega la tarjeta horizontal al DOM,
  // luego renderiza el thumb de forma asíncrona sin bloquear.
  function appendResultCard(entry: PdfEntry, pagesPerSide: number, printType: number) {
    const card = document.createElement('div');
    card.className = `result-card${entry.error ? ' is-error' : ''}`;

    // ── Columna thumb ────────────────────────────────────
    const thumbCol = document.createElement('div');
    thumbCol.className = 'result-thumb';

    if (entry.error || !entry.pdfDoc) {
      thumbCol.innerHTML = '<div class="result-thumb-error">⚠️</div>';
    } else {
      thumbCol.innerHTML = '<div class="result-thumb-loading">…</div>';
      // render asíncrono de la primera página
      (async () => {
        try {
          const page  = await entry.pdfDoc.getPage(1);
          const vp0   = page.getViewport({ scale: 1 });
          // Queremos que el canvas tenga ~90 px de ancho máx
          const scale = 88 / vp0.width;
          const vp    = page.getViewport({ scale });
          const canvas = document.createElement('canvas');
          canvas.width  = Math.floor(vp.width);
          canvas.height = Math.floor(vp.height);
          await page.render({ canvasContext: canvas.getContext('2d')!, viewport: vp }).promise;
          thumbCol.innerHTML = '';
          thumbCol.appendChild(canvas);
        } catch {
          thumbCol.innerHTML = '<div class="result-thumb-error">⚠️</div>';
        }
      })();
    }

    // ── Columna info ─────────────────────────────────────
    const infoCol = document.createElement('div');
    infoCol.className = 'result-info';

    if (entry.error) {
      infoCol.innerHTML = `
        <div class="result-name" title="${entry.name}">${entry.name}</div>
        <div style="font-size:var(--font-xs);color:#c0392b">No se pudo leer el archivo</div>`;
    } else {
      const sheets     = (entry.pages / pagesPerSide) / printType;
      const fullSheets = Math.floor(sheets);
      const hasRem     = sheets % 1 !== 0;
      let double = 0, single = 0;
      if (printType === 2) {
        double = fullSheets;
        if (hasRem) single = 1;
      } else {
        single = Math.ceil(sheets);
      }

      const sheetBadges = [
        double > 0 ? `<span class="size-badge sz-a4">${double} doble${double !== 1 ? 's' : ''}</span>` : '',
        single > 0 ? `<span class="size-badge sz-a5">${single} simple${single !== 1 ? 's' : ''}</span>` : '',
      ].filter(Boolean).join('');

      const sizePills = Object.entries(entry.pageSizes)
        .sort((a,b) => b[1]-a[1])
        .map(([sz, cnt]) => {
          const label = cnt === entry.pages ? sz : `${sz} ×${cnt}`;
          return `<span class="size-pill ${getSizeClass(sz)}">${label}</span>`;
        }).join('');

      infoCol.innerHTML = `
        <div class="result-name" title="${entry.name}">${entry.name}</div>
        <div class="result-pages-big">${entry.pages} <span style="font-size:var(--font-sm);font-weight:500;color:var(--color-gray-500)">pág.</span></div>
        <div class="result-sheets-row">${sheetBadges}</div>
        <div class="result-size-row">${sizePills}</div>`;
    }

    card.appendChild(thumbCol);
    card.appendChild(infoCol);
    resultsEl.appendChild(card);
  }

  async function renderAll() {
    if (!pdfData.length) return;
    if (typeof (window as any).toolReady === 'function') (window as any).toolReady();

    const pagesPerSide = parseInt(
      (document.querySelector('input[name="pagesPerSide"]:checked') as HTMLInputElement).value
    );
    const printType = parseInt(
      (document.querySelector('input[name="printType"]:checked') as HTMLInputElement).value
    );

    // Sólo agrega las tarjetas nuevas (fileInputMore no limpia)
    const existing = resultsEl.children.length;
    for (const entry of pdfData.slice(existing)) {
      appendResultCard(entry, pagesPerSide, printType);
    }

    renderTotals(pagesPerSide, printType);
  }

  function renderTotals(pagesPerSide: number, printType: number) {
    let totalPages = 0, totalDouble = 0, totalSingle = 0;
    const globalSizes: Record<string, number> = {};

    for (const pdf of pdfData) {
      if (pdf.error) continue;
      totalPages += pdf.pages;
      for (const [sz, cnt] of Object.entries(pdf.pageSizes)) {
        globalSizes[sz] = (globalSizes[sz] || 0) + cnt;
      }
      const sheets     = (pdf.pages / pagesPerSide) / printType;
      const fullSheets = Math.floor(sheets);
      if (printType === 2) {
        totalDouble += fullSheets;
        if (sheets % 1 !== 0) totalSingle += 1;
      } else {
        totalSingle += Math.ceil(sheets);
      }
    }

    const validCount = pdfData.filter(p => !p.error).length;
    totalsEl.innerHTML = `
      <div class="bg-white border rounded-lg p-4 text-center">
        <p class="text-xs text-gray-500 font-semibold mb-1" style="text-transform:uppercase;letter-spacing:.08em">PDFs</p>
        <p class="text-2xl font-bold text-primary mb-0">${validCount}</p>
      </div>
      <div class="bg-white border rounded-lg p-4 text-center">
        <p class="text-xs text-gray-500 font-semibold mb-1" style="text-transform:uppercase;letter-spacing:.08em">Páginas</p>
        <p class="text-2xl font-bold text-primary mb-0">${totalPages}</p>
      </div>
      ${totalDouble > 0 ? `
      <div class="bg-white border rounded-lg p-4 text-center">
        <p class="text-xs text-gray-500 font-semibold mb-1" style="text-transform:uppercase;letter-spacing:.08em">Doble faz</p>
        <p class="text-2xl font-bold mb-0" style="color:#166534">${totalDouble}</p>
      </div>` : ''}
      ${totalSingle > 0 ? `
      <div class="bg-white border rounded-lg p-4 text-center">
        <p class="text-xs text-gray-500 font-semibold mb-1" style="text-transform:uppercase;letter-spacing:.08em">Simple faz</p>
        <p class="text-2xl font-bold mb-0" style="color:#92400e">${totalSingle}</p>
      </div>` : ''}`;

    const sizeEntries = Object.entries(globalSizes).sort((a, b) => b[1] - a[1]);
    if (sizeEntries.length) {
      sizesPanel.hidden = false;
      sizesList.innerHTML = sizeEntries.map(([sz, cnt]) =>
        `<span class="size-badge ${getSizeClass(sz)}">${sz} <span class="count">${cnt} pág.</span></span>`
      ).join('');
    } else {
      sizesPanel.hidden = true;
    }
  }

  function recalcAll() {
    if (!pdfData.length) return;
    resultsEl.innerHTML = '';
    const pagesPerSide = parseInt(
      (document.querySelector('input[name="pagesPerSide"]:checked') as HTMLInputElement).value
    );
    const printType = parseInt(
      (document.querySelector('input[name="printType"]:checked') as HTMLInputElement).value
    );
    for (const entry of pdfData) appendResultCard(entry, pagesPerSide, printType);
    renderTotals(pagesPerSide, printType);
  }

  document.querySelectorAll('input[name="pagesPerSide"], input[name="printType"]')
    .forEach(input => input.addEventListener('change', recalcAll));
})();
</script>
