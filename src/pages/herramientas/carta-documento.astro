---
// src/pages/herramientas/carta-documento.astro
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Carta Documento"
  description="Completá los datos e imprimí sobre la hoja pre-impresa."
  icon="📄"
  mode="form"
  actionLabel="Configuración"
  tags={[
    { label: 'impresión', type: 'print' },
    { label: 'client-side', type: 'web' },
  ]}
>

  <!-- ══ ÁREA PRINCIPAL: pestañas ════════════════════════════ -->
  <div class="cd-main">

    <!-- Tabs nav -->
    <div class="tabs-nav" role="tablist">
      <button class="tab-btn active" id="tab-editor" role="tab" aria-selected="true"  aria-controls="panel-editor">
        ✏️ Cuerpo de CD
      </button>
      <button class="tab-btn"        id="tab-preview" role="tab" aria-selected="false" aria-controls="panel-preview">
        👁 Vista Previa
      </button>
    </div>

    <!-- Panel 1: Editor Tiptap -->
    <div class="tab-panel active" id="panel-editor" role="tabpanel" aria-labelledby="tab-editor">
      <div class="editor-card">

        <!-- Toolbar -->
        <div class="tb" id="tb">
          <button class="tbtn" id="b-bold"   title="Negrita"><b>B</b></button>
          <button class="tbtn" id="b-italic" title="Cursiva"><i>I</i></button>
          <button class="tbtn" id="b-under"  title="Subrayado"><u>U</u></button>
          <button class="tbtn" id="b-strike" title="Tachado"><s>S</s></button>
          <span class="tb-sep"></span>
          <select class="tsel" id="s-ff" title="Fuente">
            <option value="Arial,sans-serif" selected>Arial</option>
            <option value="Helvetica Neue,sans-serif">Helvetica</option>
            <option value="Times New Roman,serif">Times New Roman</option>
            <option value="Georgia,serif">Georgia</option>
            <option value="Courier New,monospace">Courier New</option>
            <option value="Verdana,sans-serif">Verdana</option>
            <option value="Tahoma,sans-serif">Tahoma</option>
            <option value="Garamond,serif">Garamond</option>
          </select>
          <select class="tsel" id="s-fs" title="Tamaño">
            <option value="7pt">7pt</option>
            <option value="8pt">8pt</option>
            <option value="9pt">9pt</option>
            <option value="10pt" selected>10pt</option>
            <option value="11pt">11pt</option>
            <option value="12pt">12pt</option>
            <option value="13pt">13pt</option>
            <option value="14pt">14pt</option>
          </select>
          <select class="tsel" id="s-lh" title="Interlineado">
            <option value="0.8">↕ 0.8</option>
            <option value="0.9">↕ 0.9</option>
            <option value="1">↕ 1.0</option>
            <option value="1.15">↕ 1.15</option>
            <option value="1.5" selected>↕ 1.5</option>
            <option value="1.75">↕ 1.75</option>
            <option value="2">↕ 2.0</option>
          </select>
          <span class="tb-sep"></span>
          <button class="tbtn" id="b-left"   title="Izquierda">←</button>
          <button class="tbtn" id="b-center" title="Centrado">↔</button>
          <button class="tbtn" id="b-right"  title="Derecha">→</button>
          <button class="tbtn on" id="b-just" title="Justificado">≡</button>
          <span class="tb-stat" id="tb-stat"></span>
        </div>

        <!-- Área de escritura -->
        <div class="editor-viewport">
          <div class="editor-page">
            <div id="editor-mount"></div>
          </div>
        </div>

      </div>
    </div>

    <!-- Panel 2: Vista Previa -->
    <div class="tab-panel" id="panel-preview" role="tabpanel" aria-labelledby="tab-preview">
      <div class="preview-wrap">
        <div class="preview-grid-bg">
          <!-- Hoja carta documento: 21.59 × 35.56 cm → ratio ~0.607 -->
          <div class="preview-sheet-card">
            <div class="preview-sheet-inner" id="previewSheetInner">
              <div class="sheet-placeholder" id="sheetPlaceholder">
                <span>📄</span>
                <small>Completá los datos para ver la carta</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /.cd-main -->

  <!-- ══ SIDEBAR ══════════════════════════════════════════════ -->
  <div slot="sidebar" class="cd-sidebar">

    <div class="sb-section-title">Remitente</div>
    <div class="field">
      <label for="name_rt">Nombre y Apellido</label>
      <input type="text" id="name_rt" placeholder="Juan Pérez" />
    </div>
    <div class="field">
      <label for="address_rt">Dirección</label>
      <input type="text" id="address_rt" placeholder="Av. Corrientes 1234" />
    </div>
    <div class="field-row-3">
      <div class="field">
        <label for="cp_rt">C.P.</label>
        <input type="text" id="cp_rt" placeholder="1043" />
      </div>
      <div class="field">
        <label for="city_rt">Localidad</label>
        <input type="text" id="city_rt" placeholder="Buenos Aires" />
      </div>
      <div class="field">
        <label for="state_rt">Provincia</label>
        <input type="text" id="state_rt" placeholder="CABA" />
      </div>
    </div>

    <div class="sb-divider"></div>

    <div class="sb-section-title">Destinatario</div>
    <div class="field">
      <label for="name_dt">Nombre y Apellido</label>
      <input type="text" id="name_dt" placeholder="María García" />
    </div>
    <div class="field">
      <label for="address_dt">Dirección</label>
      <input type="text" id="address_dt" placeholder="Belgrano 567" />
    </div>
    <div class="field-row-3">
      <div class="field">
        <label for="cp_dt">C.P.</label>
        <input type="text" id="cp_dt" placeholder="3000" />
      </div>
      <div class="field">
        <label for="city_dt">Localidad</label>
        <input type="text" id="city_dt" placeholder="Santa Fe" />
      </div>
      <div class="field">
        <label for="state_dt">Provincia</label>
        <input type="text" id="state_dt" placeholder="Santa Fe" />
      </div>
    </div>

    <div class="sb-divider"></div>

    <div class="sb-section-title">Firma</div>
    <div class="field-row-2">
      <div class="field">
        <label for="sing_name">Nombre y Apellido</label>
        <input type="text" id="sing_name" placeholder="Juan Pérez" />
      </div>
      <div class="field">
        <label for="sing_dni">DNI</label>
        <input type="text" id="sing_dni" placeholder="12.345.678" />
      </div>
    </div>

    <div class="sb-divider"></div>

    <details class="adv-details">
      <summary>Márgenes avanzados</summary>
      <div class="adv-inner">
        <p class="adv-hint">Ajustá la posición sobre la hoja pre-impresa (en cm).</p>
        <div class="field-row-2">
          <div class="field">
            <label for="margin_top">Margen superior</label>
            <input type="number" id="margin_top" value="2.56" step="0.05" />
          </div>
          <div class="field">
            <label for="margin_left">Margen izquierdo</label>
            <input type="number" id="margin_left" value="0.60" step="0.05" />
          </div>
        </div>
        <button type="button" id="btn_reset_margins" class="btn-ghost">↺ Restablecer</button>
      </div>
    </details>

    <div class="sb-divider"></div>

    <button class="btn-download btn-correo"   id="btnCorreo"   type="button">Descargar CD — Correo Argentino</button>
    <button class="btn-download btn-andreani" id="btnAndreani" type="button">Descargar CD — Andreani</button>

  </div>

</ToolLayout>

<!-- ══════════════════════════════════════════════════════════
     ESTILOS
══════════════════════════════════════════════════════════ -->
<style>
  /* ── Layout ────────────────────────────────────────────────── */
  .cd-main {
    display: flex; flex-direction: column; height: 100%;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg); overflow: hidden;
  }

  /* ── Tabs nav ──────────────────────────────────────────────── */
  .tabs-nav {
    display: flex; border-bottom: 1px solid var(--color-gray-200);
    background: var(--color-gray-50); flex-shrink: 0;
  }

  .tab-btn {
    padding: var(--space-3) var(--space-5);
    font-size: var(--font-sm); font-weight: 500; font-family: inherit;
    background: transparent; border: none; border-bottom: 2px solid transparent;
    color: var(--color-gray-500); cursor: pointer;
    margin-bottom: -1px; transition: color .15s, border-color .15s;
    display: flex; align-items: center; gap: var(--space-2);
  }

  .tab-btn:hover    { color: var(--color-gray-700); }
  .tab-btn.active   {
    color: var(--color-primary); border-bottom-color: var(--color-primary);
    font-weight: 600;
  }

  /* ── Tab panels ────────────────────────────────────────────── */
  .tab-panel          { display: none; flex: 1; overflow: hidden; flex-direction: column; }
  .tab-panel.active   { display: flex; }

  /* ── Panel 1: Editor ───────────────────────────────────────── */
  .editor-card { display: flex; flex-direction: column; flex: 1; overflow: hidden; }

  .tb {
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px;
    padding: 8px 12px; background: #f8fafc;
    border-bottom: 1px solid var(--color-gray-200); flex-shrink: 0;
  }

  .tbtn {
    background: var(--color-white); border: 1px solid var(--color-gray-200);
    color: var(--color-gray-700); cursor: pointer; border-radius: var(--radius-sm);
    padding: 3px 8px; font-size: 12px; font-family: inherit;
    display: flex; align-items: center; justify-content: center;
    min-width: 28px; height: 28px; transition: all .15s;
  }

  .tbtn:hover { background: var(--color-gray-50); border-color: var(--color-gray-400); }
  .tbtn.on    { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }

  .tsel {
    background: var(--color-white); border: 1px solid var(--color-gray-200);
    color: var(--color-gray-700); font-family: inherit; font-size: 12px;
    height: 28px; padding: 0 6px; border-radius: var(--radius-sm); cursor: pointer;
  }

  .tsel:focus { border-color: var(--color-primary); outline: none; }

  .tb-sep  { width: 1px; height: 22px; background: var(--color-gray-200); margin: 0 2px; }
  .tb-stat { margin-left: auto; font-size: 10px; color: var(--color-gray-500); white-space: nowrap; }

  .editor-viewport {
    flex: 1; overflow: auto; background: #e8e8e8;
    display: flex; align-items: flex-start; justify-content: center;
    padding: 20px;
  }

  .editor-page {
    width: 19.5cm; min-height: 14cm;
    background: #f5f0e8; border: 1px solid #c8bfa8;
    flex-shrink: 0; overflow: visible;
  }

  .editor-page .ProseMirror {
    min-height: 14cm; padding: 20px 24px; outline: none;
    font-size: 10pt; line-height: 1.5; color: #1a1a2e;
    text-align: justify; font-family: Arial, Helvetica, sans-serif;
  }

  .editor-page .ProseMirror p { margin: 0; }
  .editor-page .ProseMirror ::selection { background: rgba(99,102,241,.25); }

  /* ── Panel 2: Vista Previa ─────────────────────────────────── */
  .preview-wrap {
    flex: 1; overflow: auto; display: flex; align-items: center; justify-content: center;
    padding: var(--space-6);
  }

  .preview-grid-bg {
    width: 100%; height: 100%; min-height: 280px;
    display: flex; align-items: center; justify-content: center;
    background-color: #f0f2f5;
    background-image:
      linear-gradient(to right, #d5d8de 1px, transparent 1px),
      linear-gradient(to bottom, #d5d8de 1px, transparent 1px);
    background-size: 20px 20px;
    border-radius: var(--radius-md); padding: var(--space-6);
  }

  /* 21.59 × 35.56 cm → ratio 0.607. Preview: 180 × 296 px */
  .preview-sheet-card {
    background: #fff;
    box-shadow: 0 4px 24px rgba(0,0,0,.18), 0 1px 4px rgba(0,0,0,.08);
    border-radius: 2px;
    width: 180px; height: 296px;
    flex-shrink: 0; overflow: hidden;
    display: flex; align-items: stretch;
  }

  .preview-sheet-inner {
    flex: 1; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }

  .sheet-placeholder {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    color: var(--color-gray-500);
  }

  .sheet-placeholder span { font-size: 1.8rem; opacity: .3; }
  .sheet-placeholder small { font-size: var(--font-xs); text-align: center; }

  .preview-content {
    position: absolute; inset: 0; padding: 7px;
    font-size: 3.5px; line-height: 1.4; overflow: hidden;
    word-break: break-word; color: #333;
  }

  .preview-content .pr-section {
    font-size: 2.5px; color: #aaa; text-transform: uppercase;
    letter-spacing: .3px; margin-bottom: 1px; margin-top: 2px;
  }

  .preview-content .pr-row { display: flex; gap: 3px; margin-bottom: .8px; }
  .preview-content .pr-label { color: #888; min-width: 16px; font-size: 3px; flex-shrink: 0; }
  .preview-content .pr-val { color: #111; font-weight: 600; }
  .preview-content .pr-divider { height: .5px; background: #ccc; margin: 2px 0; }
  .preview-content .pr-body { font-size: 3px; color: #222; margin-top: 2px; max-height: 110px; overflow: hidden; }
  .preview-content .pr-hint { font-size: 2.8px; color: #bbb; font-style: italic; }

  /* ── Sidebar ───────────────────────────────────────────────── */
  .cd-sidebar { display: flex; flex-direction: column; gap: var(--space-2); }

  .sb-section-title {
    font-size: var(--font-xs); font-weight: 600; text-transform: uppercase;
    letter-spacing: .1em; color: var(--color-gray-500);
  }

  .sb-divider { height: 1px; background: var(--color-gray-200); margin: var(--space-1) 0; }

  .field { display: flex; flex-direction: column; gap: var(--space-1); }
  .field label { font-size: var(--font-xs); font-weight: 500; color: var(--color-gray-700); margin-bottom: 0; }

  .field-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .field-row-3 { display: grid; grid-template-columns: 64px 1fr 1fr; gap: var(--space-2); }

  .adv-details {
    background: var(--color-white); border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md); padding: var(--space-3);
  }

  .adv-details summary {
    font-size: var(--font-xs); font-weight: 500; color: var(--color-gray-700);
    cursor: pointer; user-select: none; list-style: none;
    display: flex; align-items: center; gap: var(--space-2);
  }

  .adv-details summary::before { content: '▶'; font-size: .6rem; color: var(--color-gray-500); transition: transform .2s; }
  .adv-details[open] summary::before { transform: rotate(90deg); }

  .adv-inner { margin-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); }

  .adv-hint {
    font-size: var(--font-xs); color: var(--color-gray-500);
    background: var(--color-gray-50); border-left: 3px solid var(--color-gray-200);
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); margin: 0;
  }

  .btn-ghost {
    background: transparent; border: none; color: var(--color-gray-500);
    font-size: var(--font-xs); cursor: pointer; font-family: inherit; padding: 0;
  }

  .btn-ghost:hover { color: var(--color-accent); }

  .btn-download {
    width: 100%; padding: var(--space-3); font-size: var(--font-sm); font-weight: 600;
    border: none; border-radius: var(--radius-md); color: #fff;
    cursor: pointer; font-family: inherit; transition: background .2s;
  }

  .btn-download:disabled { background: var(--color-gray-200) !important; color: var(--color-gray-500); cursor: not-allowed; }

  .btn-correo   { background: #1a56db; }
  .btn-correo:hover:not(:disabled)   { background: #1447bd; }
  .btn-andreani { background: #059669; }
  .btn-andreani:hover:not(:disabled) { background: #047857; }
</style>

<script type="module">
// ══════════════════════════════════════════════════════════════════
// Importar Tiptap y extensiones desde esm.sh (ESM, sin bundle local)
// Importar pdf-lib desde esm.sh
// Todo en un único <script type="module"> — sin IIFE externo.
// ══════════════════════════════════════════════════════════════════
import { Editor, Extension }      from 'https://esm.sh/@tiptap/core@2.4.0';
import StarterKit                 from 'https://esm.sh/@tiptap/starter-kit@2.4.0';
import Underline                  from 'https://esm.sh/@tiptap/extension-underline@2.4.0';
import TextAlign                  from 'https://esm.sh/@tiptap/extension-text-align@2.4.0';
import TextStyle                  from 'https://esm.sh/@tiptap/extension-text-style@2.4.0';
import FontFamily                 from 'https://esm.sh/@tiptap/extension-font-family@2.4.0';
import { PDFDocument, rgb, StandardFonts } from 'https://esm.sh/pdf-lib@1.17.1?bundle';

// FontSize: extensión custom liviana (no existe paquete oficial estable)
const FontSize = TextStyle.extend({
  addAttributes() {
    return {
      ...this.parent?.(),
      fontSize: {
        default: null,
        parseHTML: el => el.style.fontSize || null,
        renderHTML: attrs => attrs.fontSize ? { style: 'font-size:' + attrs.fontSize } : {},
      },
    };
  },
});

// Alias para compatibilidad con el código existente
const B = { Editor, Extension, StarterKit, Underline, TextAlign, FontFamily, FontSize };

// ══════════════════════════════════════════════════════════════════
// PESTAÑAS
// ══════════════════════════════════════════════════════════════════
const tabEditor  = document.getElementById('tab-editor');
const tabPreview = document.getElementById('tab-preview');
const panelEditor  = document.getElementById('panel-editor');
const panelPreview = document.getElementById('panel-preview');

function activateTab(tab) {
  [tabEditor, tabPreview].forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
  [panelEditor, panelPreview].forEach(p => p.classList.remove('active'));
  tab.classList.add('active');
  tab.setAttribute('aria-selected', 'true');
  document.getElementById(tab.getAttribute('aria-controls')).classList.add('active');
}

tabEditor.addEventListener('click',  () => activateTab(tabEditor));
tabPreview.addEventListener('click', () => { activateTab(tabPreview); updatePreview(); });

// ══════════════════════════════════════════════════════════════════
// TIPTAP — inicialización del editor
// ══════════════════════════════════════════════════════════════════
const LineHeightExt = B.Extension.create({
  name: 'lineHeight',
  addGlobalAttributes() {
    return [{
      types: ['paragraph', 'heading'],
      attributes: {
        lineHeight: {
          default: '1.5',
          parseHTML: el => el.style.lineHeight || '1.5',
          renderHTML: attrs =>
            attrs.lineHeight && attrs.lineHeight !== '1.5'
              ? { style: 'line-height:' + attrs.lineHeight }
              : {},
        },
      },
    }];
  },
  addCommands() {
    return {
      setLineHeight: val => ({ commands }) =>
        commands.updateAttributes('paragraph', { lineHeight: val }),
    };
  },
});

const editor = new B.Editor({
  element: document.getElementById('editor-mount'),
  extensions: [
    B.StarterKit,
    B.Underline,
    B.TextAlign.configure({ types: ['heading', 'paragraph'], defaultAlignment: 'justify' }),
    B.FontFamily.configure({ types: ['textStyle'] }),
    B.FontSize,
    LineHeightExt,
  ],
  content: '<p>Escriba aquí el cuerpo de la carta documento.</p>',
  onTransaction: () => { syncToolbar(); },
});

// ══════════════════════════════════════════════════════════════════
// TOOLBAR
// ══════════════════════════════════════════════════════════════════
function q(id) { return document.getElementById(id); }

function syncToolbar() {
  q('b-bold')  .classList.toggle('on', editor.isActive('bold'));
  q('b-italic').classList.toggle('on', editor.isActive('italic'));
  q('b-under') .classList.toggle('on', editor.isActive('underline'));
  q('b-strike').classList.toggle('on', editor.isActive('strike'));
  q('b-left')  .classList.toggle('on', editor.isActive({ textAlign: 'left' }));
  q('b-center').classList.toggle('on', editor.isActive({ textAlign: 'center' }));
  q('b-right') .classList.toggle('on', editor.isActive({ textAlign: 'right' }));
  q('b-just')  .classList.toggle('on', editor.isActive({ textAlign: 'justify' }));
  const txt = editor.getText();
  q('tb-stat').textContent = txt.length + ' c · ' + txt.split(/\s+/).filter(Boolean).length + ' pal';
}

q('b-bold')  .onclick = () => editor.chain().focus().toggleBold().run();
q('b-italic').onclick = () => editor.chain().focus().toggleItalic().run();
q('b-under') .onclick = () => editor.chain().focus().toggleUnderline().run();
q('b-strike').onclick = () => editor.chain().focus().toggleStrike().run();
q('b-left')  .onclick = () => editor.chain().focus().setTextAlign('left').run();
q('b-center').onclick = () => editor.chain().focus().setTextAlign('center').run();
q('b-right') .onclick = () => editor.chain().focus().setTextAlign('right').run();
q('b-just')  .onclick = () => editor.chain().focus().setTextAlign('justify').run();

q('s-ff').onchange = function () { editor.chain().focus().setFontFamily(this.value).run(); };
q('s-fs').onchange = function () { editor.chain().focus().setMark('textStyle', { fontSize: this.value }).run(); };
q('s-lh').onchange = function () { editor.chain().focus().setLineHeight(this.value).run(); };

// ══════════════════════════════════════════════════════════════════
// DATOS DEL FORMULARIO
// ══════════════════════════════════════════════════════════════════
function gv(id) { const el = q(id); return el ? el.value.trim() : ''; }

function getDatos() {
  return {
    rt:     { name: gv('name_rt'), address: gv('address_rt'), cp: gv('cp_rt'), city: gv('city_rt'), state: gv('state_rt') },
    dt:     { name: gv('name_dt'), address: gv('address_dt'), cp: gv('cp_dt'), city: gv('city_dt'), state: gv('state_dt') },
    firma:  gv('sing_name'),
    dni:    gv('sing_dni'),
    mTop:   parseFloat(gv('margin_top'))  || 2.56,
    mLeft:  parseFloat(gv('margin_left')) || 0.60,
    bodyJson: editor.getJSON(),
    bodyText: editor.getText(),
  };
}

// ══════════════════════════════════════════════════════════════════
// PREVIEW (pestaña Vista Previa)
// ══════════════════════════════════════════════════════════════════
function esc(s) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function updatePreview() {
  const d = getDatos();
  const inner = q('previewSheetInner');
  const hasContent = d.rt.name || d.dt.name || d.bodyText.trim();

  if (!hasContent) {
    inner.innerHTML = '<div class="sheet-placeholder"><span>📄</span><small>Completá los datos para ver la carta</small></div>';
    return;
  }

  function row(label, val) {
    if (!val) return '';
    return `<div class="pr-row">
      <span class="pr-label">${esc(label)}</span>
      <span class="pr-val">${esc(val)}</span>
    </div>`;
  }

  function block(title, p) {
    const loc = [p.cp, p.city].filter(Boolean).join(' ');
    return `
      <div class="pr-section">${title}</div>
      ${row('Nombre', p.name)}
      ${row('Dir.', p.address)}
      ${row('CP', loc)}
      ${row('Prov.', p.state)}`;
  }

  const bodyPreview = esc(d.bodyText.slice(0, 400));

  inner.innerHTML = `<div class="preview-content">
    ${block('Remitente', d.rt)}
    <div class="pr-divider"></div>
    ${block('Destinatario', d.dt)}
    <div class="pr-divider"></div>
    <div class="pr-body">${bodyPreview || '<span class="pr-hint">Sin texto aún</span>'}</div>
    ${d.firma ? `<div class="pr-divider"></div>${row('Firma', d.firma)}${row('DNI', d.dni)}` : ''}
  </div>`;
}

