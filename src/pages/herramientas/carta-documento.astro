// ══════════════════════════════════════════════════════════════════
// PDF — helpers
// ══════════════════════════════════════════════════════════════════
const CM = 72 / 2.54;  // puntos por cm
const BLACK = rgb(0, 0, 0);

// ── Caché de fonts por documento ─────────────────────────────────
// pdf-lib acepta embeber la misma font varias veces pero es redundante.
// La cacheamos con WeakMap keyed por doc.
const _fontCache = new WeakMap();

async function getFont(doc, family, bold, italic) {
  if (!_fontCache.has(doc)) _fontCache.set(doc, {});
  const cache = _fontCache.get(doc);

  // Mapear familia Tiptap → familia pdf-lib
  // pdf-lib solo tiene Helvetica (sans), Times (serif), Courier (mono).
  // Fonts CSS que llegan como "Arial,sans-serif", "Times New Roman,serif", etc.
  const isSerif  = /times|georgia|garamond|serif/i.test(family || '');
  const isMono   = /courier|mono/i.test(family || '');
  const base     = isMono ? 'Courier' : isSerif ? 'Times' : 'Helvetica';

  // Nombre de la StandardFont
  const sfName = base === 'Courier'
    ? (bold && italic ? StandardFonts.CourierBoldOblique
       : bold         ? StandardFonts.CourierBold
       : italic       ? StandardFonts.CourierOblique
       :                StandardFonts.Courier)
    : base === 'Times'
    ? (bold && italic ? StandardFonts.TimesRomanBoldItalic
       : bold         ? StandardFonts.TimesRomanBold
       : italic       ? StandardFonts.TimesRomanItalic
       :                StandardFonts.TimesRoman)
    : /* Helvetica */
      (bold && italic ? StandardFonts.HelveticaBoldOblique
       : bold         ? StandardFonts.HelveticaBold
       : italic       ? StandardFonts.HelveticaOblique
       :                StandardFonts.Helvetica);

  const key = sfName;
  if (!cache[key]) cache[key] = await doc.embedFont(sfName);
  return cache[key];
}

// ── Parsear nodos de Tiptap ────────────────────────────────────────
// Devuelve array de párrafos: { align, lineH, runs[] }
// Cada run: { text, bold, italic, underline, fontSize, fontFamily }
function extractParagraphs(json) {
  const paragraphs = [];
  if (!json?.content) return paragraphs;

  for (const node of json.content) {
    if (node.type !== 'paragraph' && node.type !== 'heading') continue;

    const align  = node.attrs?.textAlign || 'left';
    const lineH  = parseFloat(node.attrs?.lineHeight || '1.5');
    const runs   = [];

    for (const inline of node.content || []) {
      if (inline.type === 'hardBreak') {
        paragraphs.push({ align, lineH, runs: [...runs] });
        runs.length = 0;
        continue;
      }
      if (inline.type !== 'text') continue;

      let bold = false, italic = false, underline = false;
      let fontSize = 10, fontFamily = '';

      for (const mk of inline.marks || []) {
        if (mk.type === 'bold')      bold = true;
        if (mk.type === 'italic')    italic = true;
        if (mk.type === 'underline') underline = true;
        if (mk.type === 'textStyle') {
          if (mk.attrs?.fontSize)   fontSize   = parseFloat(mk.attrs.fontSize) || 10;
          if (mk.attrs?.fontFamily) fontFamily = mk.attrs.fontFamily;
        }
      }
      runs.push({ text: inline.text || '', bold, italic, underline, fontSize, fontFamily });
    }

    paragraphs.push({ align, lineH, runs });
  }
  return paragraphs;
}

// ── Word-wrap ──────────────────────────────────────────────────────
// Toma el texto de todos los runs de un párrafo (considerando el font
// del primer run para el wrap — aproximación válida en párrafos homogéneos)
// y devuelve array de strings ya cortadas.
function wrapRuns(runs, fontForWrap, defaultFs, maxWPt) {
  const fullText = runs.map(r => r.text).join('');
  const fs = runs[0]?.fontSize || defaultFs;
  const words = fullText.split(' ');
  const lines = [];
  let cur = '';
  for (const word of words) {
    const test = cur ? cur + ' ' + word : word;
    if (fontForWrap.widthOfTextAtSize(test, fs) > maxWPt && cur) {
      lines.push(cur); cur = word;
    } else { cur = test; }
  }
  if (cur) lines.push(cur);
  return lines.length ? lines : [''];
}

// ── Calcular xOffset según alineación ─────────────────────────────
function alignX(xBase, wPt, lineText, font, fs, align) {
  if (align === 'center') {
    const tw = font.widthOfTextAtSize(lineText, fs);
    return xBase + (wPt - tw) / 2;
  }
  if (align === 'right') {
    const tw = font.widthOfTextAtSize(lineText, fs);
    return xBase + wPt - tw;
  }
  // left / justify → xBase (justify real requeriría espaciado variable, no soportado en pdf-lib)
  return xBase;
}

// ── Dibujar campo simple (datos del formulario) ──────────────────
async function drawField(page, text, coord, mTop, mLeft) {
  if (!text) return;
  const doc   = page.doc;
  const font  = await getFont(doc, '', false, false);
  const pH    = page.getHeight();
  const xPt   = (coord.x + mLeft) * CM;
  const wPt   = coord.w * CM;
  const fsPt  = coord.fs || 8;
  const lhPt  = fsPt * 1.3;
  const yTop  = pH - (coord.y + mTop) * CM - fsPt;

  const words = String(text).split(' ');
  const lines = [];
  let cur = '';
  for (const word of words) {
    const test = cur ? cur + ' ' + word : word;
    if (font.widthOfTextAtSize(test, fsPt) > wPt && cur) { lines.push(cur); cur = word; }
    else cur = test;
  }
  if (cur) lines.push(cur);

  for (let i = 0; i < lines.length; i++) {
    const y = yTop - i * lhPt;
    if (y > 0) page.drawText(lines[i], { x: xPt, y, size: fsPt, font, color: BLACK });
  }
}

// ── Dibujar cuerpo del editor ─────────────────────────────────────
// Respeta: fontFamily, fontSize, bold, italic (por párrafo homogéneo),
// textAlign (left/center/right/justify), lineHeight, word-wrap.
async function drawBody(page, json, coord, mTop, mLeft) {
  const doc   = page.doc;
  const pH    = page.getHeight();
  const xBase = (coord.x + mLeft) * CM;
  const wPt   = coord.w * CM;
  const yMax  = pH - (coord.y + mTop) * CM;
  const yMin  = pH - (coord.y + mTop + coord.h) * CM;
  const defFs = coord.fs || 10;

  let curY = yMax;

  for (const para of extractParagraphs(json)) {
    if (!para.runs.length) {
      // Párrafo vacío → salto de línea
      curY -= defFs * para.lineH;
      if (curY < yMin) return;
      continue;
    }

    // Usar el estilo del primer run del párrafo para word-wrap y alineación.
    // Para documentos de carta (texto mayormente homogéneo) es suficiente.
    const firstRun = para.runs[0];
    const fsPt     = firstRun.fontSize || defFs;
    const lhPt     = fsPt * para.lineH;
    const font      = await getFont(doc, firstRun.fontFamily, firstRun.bold, firstRun.italic);

    const lines = wrapRuns(para.runs, font, defFs, wPt);

    for (let li = 0; li < lines.length; li++) {
      const yDraw = curY - fsPt;
      if (yDraw < yMin) return;

      const line = lines[li];
      if (line.trim()) {
        // Alineación: en la última línea de un párrafo justify actúa como left
        const isLastLine = li === lines.length - 1;
        const effectiveAlign = (para.align === 'justify' && isLastLine) ? 'left' : para.align;
        const xDraw = alignX(xBase, wPt, line, font, fsPt, effectiveAlign);
        page.drawText(line, { x: xDraw, y: yDraw, size: fsPt, font, color: BLACK });
      }
      curY -= lhPt;
    }
  }
}

// ══════════════════════════════════════════════════════════════════
// PDF — generación completa
// ══════════════════════════════════════════════════════════════════
async function generarPDF(coords, filename) {
  const d = getDatos();

  const doc  = await PDFDocument.create();
  doc.setTitle('Carta Documento');
  doc.setProducer('edetools / carta-documento');

  // Hoja oficio: 21.59 × 35.56 cm
  const pW   = 21.59 * CM;
  const pH   = 35.56 * CM;
  const page = doc.addPage([pW, pH]);

  const mT = d.mTop;
  const mL = d.mLeft;

  const df = (coord, text) => drawField(page, text, coord, mT, mL);

  // Bloque 1
  await df(coords.b1_name_rt,    d.rt.name);
  await df(coords.b1_name_dt,    d.dt.name);
  await df(coords.b1_address_rt, d.rt.address);
  await df(coords.b1_address_dt, d.dt.address);
  await df(coords.b1_cp_rt,      d.rt.cp);
  await df(coords.b1_city_rt,    d.rt.city);
  await df(coords.b1_state_rt,   d.rt.state);
  await df(coords.b1_cp_dt,      d.dt.cp);
  await df(coords.b1_city_dt,    d.dt.city);
  await df(coords.b1_state_dt,   d.dt.state);

  // Cuerpo
  await drawBody(page, d.bodyJson, coords.body, mT, mL);

  // Firma
  await df(coords.firma, d.firma);
  await df(coords.dni,   d.dni ? 'DNI: ' + d.dni : '');

  // Bloque 2 (talón)
  await df(coords.b2_name_rt,    d.rt.name);
  await df(coords.b2_name_dt,    d.dt.name);
  await df(coords.b2_address_rt, d.rt.address);
  await df(coords.b2_address_dt, d.dt.address);
  await df(coords.b2_cp_rt,      d.rt.cp);
  await df(coords.b2_city_rt,    d.rt.city);
  await df(coords.b2_state_rt,   d.rt.state);
  await df(coords.b2_cp_dt,      d.dt.cp);
  await df(coords.b2_city_dt,    d.dt.city);
  await df(coords.b2_state_dt,   d.dt.state);

  const bytes = await doc.save();
  const blob  = new Blob([bytes], { type: 'application/pdf' });
  const url   = URL.createObjectURL(blob);
  const a     = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// ══════════════════════════════════════════════════════════════════
// BOTONES DE DESCARGA
// ══════════════════════════════════════════════════════════════════
async function handleDownload(coords, filename, btn) {
  btn.disabled = true;
  const orig = btn.textContent;
  btn.textContent = 'Generando PDF…';
  try {
    await generarPDF(coords, filename);
  } catch (err) {
    console.error('[carta-documento] PDF error:', err);
    alert('Error generando el PDF: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.textContent = orig;
  }
}

q('btnCorreo')  .addEventListener('click', () => handleDownload(CORREO,   'carta-documento-correo-argentino.pdf', q('btnCorreo')));
q('btnAndreani').addEventListener('click', () => handleDownload(ANDREANI, 'carta-documento-andreani.pdf',         q('btnAndreani')));

