---
// src/pages/herramientas/whatsapp-imprimible.astro
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="WhatsApp Imprimible"
  description="Convertí texto con formato WhatsApp (*negrita*, _cursiva_, ~tachado~) a HTML imprimible. Ajustá tipografía, márgenes e interlineado antes de imprimir."
  icon="💬"
  tags={[
    { label: 'impresión', type: 'print' },
    { label: 'client-side', type: 'web' },
  ]}
>

  <!-- @page dinámico inyectado por JS -->
  <style id="wa-print-style"></style>

  <div class="wa-wrap">

    <!-- ── Barra de controles tipográficos ──────────────── -->
    <div class="typo-bar">

      <div class="typo-group">
        <label for="wa-font-family">Fuente</label>
        <select id="wa-font-family">
          <option value="Roboto, sans-serif">Roboto</option>
          <option value="Georgia, serif">Georgia</option>
          <option value="'Times New Roman', serif">Times New Roman</option>
          <option value="Arial, sans-serif">Arial</option>
          <option value="'Courier New', monospace">Courier New</option>
          <option value="Garamond, serif">Garamond</option>
          <option value="Verdana, sans-serif">Verdana</option>
        </select>
      </div>

      <div class="typo-sep"></div>

      <div class="typo-group">
        <label for="wa-font-size">Tamaño (pt)</label>
        <div class="slider-row">
          <input type="range" id="wa-font-size" min="8" max="24" value="11" step="0.5" />
          <span class="slider-val" id="wa-font-size-val">11pt</span>
        </div>
      </div>

      <div class="typo-group">
        <label for="wa-line-height">Interlineado</label>
        <div class="slider-row">
          <input type="range" id="wa-line-height" min="1" max="3" value="1.6" step="0.05" />
          <span class="slider-val" id="wa-line-height-val">1.6</span>
        </div>
      </div>

      <div class="typo-sep"></div>

      <div class="typo-group">
        <label for="wa-para-spacing">Esp. párrafo (em)</label>
        <div class="slider-row">
          <input type="range" id="wa-para-spacing" min="0" max="2" value="0.4" step="0.05" />
          <span class="slider-val" id="wa-para-spacing-val">0.4em</span>
        </div>
      </div>

      <div class="typo-group">
        <label for="wa-indent">Sangría (em)</label>
        <div class="slider-row">
          <input type="range" id="wa-indent" min="0" max="4" value="0" step="0.5" />
          <span class="slider-val" id="wa-indent-val">0em</span>
        </div>
      </div>

      <div class="typo-sep"></div>

      <div class="typo-group">
        <label for="wa-text-align">Alineación</label>
        <select id="wa-text-align">
          <option value="left">Izquierda</option>
          <option value="justify">Justificado</option>
          <option value="center">Centrado</option>
          <option value="right">Derecha</option>
        </select>
      </div>

      <div class="typo-group">
        <label for="wa-margin">Margen imp. (cm)</label>
        <div class="slider-row">
          <input type="range" id="wa-margin" min="0.5" max="4" value="2" step="0.25" />
          <span class="slider-val" id="wa-margin-val">2cm</span>
        </div>
      </div>

      <div class="typo-sep"></div>

      <button class="btn-reset" id="wa-reset-btn" type="button">↺ Restablecer</button>
      <button class="btn-print" id="wa-print-btn" type="button">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
          <rect x="6" y="14" width="12" height="8"/>
          <circle cx="18" cy="11.5" r="0.5" fill="currentColor"/>
        </svg>
        Imprimir
      </button>

    </div>

    <!-- ── Paneles ──────────────────────────────────────── -->
    <div class="wa-panels">

      <!-- Entrada -->
      <div class="wa-panel">
        <span class="panel-label">Entrada WhatsApp</span>
        <textarea
          id="wa-input"
          placeholder="Pegá el texto de WhatsApp aquí…

Ej: *negrita*, _cursiva_, ~tachado~, `código`

---
(esta línea genera un salto de página al imprimir)"
        ></textarea>
        <p class="wa-hint">
          <code>*negrita*</code> &nbsp;·&nbsp;
          <code>_cursiva_</code> &nbsp;·&nbsp;
          <code>~tachado~</code> &nbsp;·&nbsp;
          <code>`código`</code> &nbsp;·&nbsp;
          <code>```bloque```</code> &nbsp;·&nbsp;
          <code>---</code> = salto de página
        </p>
      </div>

      <!-- Preview -->
      <div class="wa-panel">
        <span class="panel-label">Preview</span>
        <div id="wa-preview"></div>
      </div>

    </div>
  </div>

</ToolLayout>

<style>
  /* ── Wrapper ─────────────────────────────────────────── */
  .wa-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* ── Barra tipográfica ───────────────────────────────── */
  .typo-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
  }

  .typo-sep {
    width: 1px;
    height: 36px;
    background: var(--color-gray-200);
    align-self: flex-end;
    flex-shrink: 0;
  }

  .typo-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 110px;
  }

  .typo-group label {
    font-size: var(--font-xs);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    white-space: nowrap;
    margin-bottom: 0;
  }

  .typo-group select {
    font-size: var(--font-sm);
    padding: var(--space-1) var(--space-2);
    height: 32px;
  }

  /* Slider rows */
  .slider-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .slider-row input[type="range"] {
    flex: 1;
    min-width: 80px;
    accent-color: var(--color-primary);
    cursor: pointer;
    width: auto;
    padding: 0;
    border: none;
    background: none;
    box-shadow: none;
  }

  .slider-row input[type="range"]:focus { box-shadow: none; outline: none; }

  .slider-val {
    font-size: var(--font-xs);
    color: var(--color-gray-500);
    min-width: 34px;
    text-align: right;
  }

  /* Botones de la barra */
  .btn-reset {
    height: 32px;
    padding: 0 var(--space-3);
    background: var(--color-gray-100);
    color: var(--color-gray-700);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    font-size: var(--font-sm);
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    align-self: flex-end;
    transition: background 0.2s;
  }

  .btn-reset:hover { background: var(--color-gray-200); }

  .btn-print {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 32px;
    padding: 0 var(--space-4);
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--font-sm);
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    align-self: flex-end;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .btn-print:hover { background: var(--color-primary-dark); }

  /* ── Paneles lado a lado ─────────────────────────────── */
  .wa-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  @media (max-width: 640px) {
    .wa-panels { grid-template-columns: 1fr; }
    .typo-sep  { display: none; }
  }

  .wa-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .panel-label {
    font-size: var(--font-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }

  /* Textarea de entrada */
  #wa-input {
    width: 100%;
    min-height: 360px;
    resize: vertical;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    background: var(--color-gray-50);
    font-family: monospace;
    font-size: var(--font-sm);
    line-height: 1.7;
    color: var(--color-gray-900);
    transition: border-color 0.2s;
  }

  #wa-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(26,26,46,0.08);
  }

  /* Preview */
  #wa-preview {
    min-height: 360px;
    padding: var(--space-4);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    background: var(--color-white);
    font-size: var(--font-sm);
    line-height: 1.75;
    color: var(--color-gray-900);
    overflow-y: auto;
  }

  #wa-preview:empty::before {
    content: 'El preview aparece aquí…';
    color: var(--color-gray-500);
    font-style: italic;
  }

  #wa-preview p       { margin: 0 0 0.3em; }
  #wa-preview strong  { font-weight: 700; }
  #wa-preview em      { font-style: italic; }
  #wa-preview s       { text-decoration: line-through; }

  #wa-preview code {
    font-family: monospace;
    font-size: 0.9em;
    background: var(--color-gray-100);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-sm);
    padding: 1px 5px;
  }

  #wa-preview pre {
    font-family: monospace;
    font-size: 0.85em;
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    margin: var(--space-2) 0;
    white-space: pre-wrap;
  }

  /* Indicador visual de salto de página */
  #wa-preview .page-break-marker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0;
    color: var(--color-gray-500);
    font-size: var(--font-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #wa-preview .page-break-marker::before,
  #wa-preview .page-break-marker::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--color-gray-200);
  }

  /* Hint de formatos */
  .wa-hint {
    font-size: var(--font-xs);
    color: var(--color-gray-500);
    margin: 0;
    line-height: 2;
  }

  .wa-hint code {
    background: var(--color-gray-100);
    padding: 1px 4px;
    border-radius: var(--radius-sm);
    font-family: monospace;
    font-size: inherit;
    border: none;
  }

  /* ── Impresión ───────────────────────────────────────── */
  @media print {
    /* Ocultar todo el shell + panel izquierdo */
    .site-header,
    .breadcrumb-bar,
    .tool-hero,
    .typo-bar,
    .wa-panel:first-child,
    .wa-hint,
    .panel-label,
    .site-footer { display: none !important; }

    .wa-panels { grid-template-columns: 1fr; }

    #wa-preview {
      border: none;
      padding: 0;
      min-height: unset;
      color: #000;
    }

    /* Salto de página real */
    #wa-preview .page-break-marker {
      display: block;
      visibility: hidden;
      height: 0;
      page-break-after: always;
      margin: 0;
    }

    #wa-preview pre,
    #wa-preview code {
      font-family: 'Courier New', monospace;
      background: #f5f5f5;
    }
  }
</style>

<script>
(function () {
  const inputEl   = document.getElementById('wa-input')    as HTMLTextAreaElement;
  const previewEl = document.getElementById('wa-preview')  as HTMLDivElement;
  const printStyleEl = document.getElementById('wa-print-style') as HTMLStyleElement;

  // ── Parser ─────────────────────────────────────────────
  function escHtml(t: string) {
    return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function parseInline(t: string) {
    let s = escHtml(t);
    s = s.replace(/\*([^*\n]+)\*/g, '<strong>$1</strong>');
    s = s.replace(/_([^_\n]+)_/g,   '<em>$1</em>');
    s = s.replace(/~([^~\n]+)~/g,   '<s>$1</s>');
    s = s.replace(/`([^`\n]+)`/g,   '<code>$1</code>');
    return s;
  }

  function convertir(raw: string) {
    if (!raw.trim()) { previewEl.innerHTML = ''; return; }

    const lines = raw.split('\n');
    const out:   string[] = [];
    let inCode   = false;
    let codeAcc: string[] = [];

    lines.forEach(line => {
      if (line.startsWith('```')) {
        if (!inCode) {
          inCode = true; codeAcc = [];
        } else {
          inCode = false;
          out.push('<pre>' + escHtml(codeAcc.join('\n')) + '</pre>');
          codeAcc = [];
        }
        return;
      }
      if (inCode) { codeAcc.push(line); return; }

      if (/^\s*---\s*$/.test(line)) {
        out.push('<div class="page-break-marker">salto de página</div>');
        return;
      }
      if (line.trim() === '') { out.push('<p>&nbsp;</p>'); return; }
      out.push('<p>' + parseInline(line) + '</p>');
    });

    if (inCode && codeAcc.length)
      out.push('<pre>' + escHtml(codeAcc.join('\n')) + '</pre>');

    previewEl.innerHTML = out.join('\n');
    applyTypo(readControls()); // re-aplicar estilos a los nuevos párrafos
  }

  inputEl.addEventListener('input', () => convertir(inputEl.value));

  // ── Imprimir ───────────────────────────────────────────
  document.getElementById('wa-print-btn')!.addEventListener('click', () => {
    convertir(inputEl.value);
    window.print();
  });

  // ── Controles tipográficos ─────────────────────────────
  const DEFAULTS = {
    fontFamily:  'Roboto, sans-serif',
    fontSize:    11,
    lineHeight:  1.6,
    paraSpacing: 0.4,
    indent:      0,
    textAlign:   'left',
    margin:      2,
  };

  function applyTypo(cfg: typeof DEFAULTS) {
    previewEl.style.fontFamily = cfg.fontFamily;
    previewEl.style.fontSize   = cfg.fontSize + 'pt';
    previewEl.style.lineHeight = String(cfg.lineHeight);
    previewEl.style.textAlign  = cfg.textAlign;

    previewEl.querySelectorAll('p').forEach(p => {
      (p as HTMLElement).style.marginBottom = cfg.paraSpacing + 'em';
      (p as HTMLElement).style.textIndent   = cfg.indent + 'em';
    });

    printStyleEl.textContent =
      `@media print { @page { margin: ${cfg.margin}cm; }
       #wa-preview p {
         font-family: ${cfg.fontFamily};
         font-size: ${cfg.fontSize}pt;
         line-height: ${cfg.lineHeight};
         margin-bottom: ${cfg.paraSpacing}em;
         text-indent: ${cfg.indent}em;
         text-align: ${cfg.textAlign};
       } }`;
  }

  function readControls(): typeof DEFAULTS {
    return {
      fontFamily:  (document.getElementById('wa-font-family')  as HTMLSelectElement).value,
      fontSize:    parseFloat((document.getElementById('wa-font-size')    as HTMLInputElement).value),
      lineHeight:  parseFloat((document.getElementById('wa-line-height')  as HTMLInputElement).value),
      paraSpacing: parseFloat((document.getElementById('wa-para-spacing') as HTMLInputElement).value),
      indent:      parseFloat((document.getElementById('wa-indent')       as HTMLInputElement).value),
      textAlign:   (document.getElementById('wa-text-align')  as HTMLSelectElement).value,
      margin:      parseFloat((document.getElementById('wa-margin')       as HTMLInputElement).value),
    };
  }

  function setControls(cfg: typeof DEFAULTS) {
    (document.getElementById('wa-font-family')       as HTMLSelectElement).value = cfg.fontFamily;
    (document.getElementById('wa-font-size')         as HTMLInputElement).value  = String(cfg.fontSize);
    (document.getElementById('wa-font-size-val')     as HTMLSpanElement).textContent = cfg.fontSize + 'pt';
    (document.getElementById('wa-line-height')       as HTMLInputElement).value  = String(cfg.lineHeight);
    (document.getElementById('wa-line-height-val')   as HTMLSpanElement).textContent = cfg.lineHeight.toFixed(2);
    (document.getElementById('wa-para-spacing')      as HTMLInputElement).value  = String(cfg.paraSpacing);
    (document.getElementById('wa-para-spacing-val')  as HTMLSpanElement).textContent = cfg.paraSpacing + 'em';
    (document.getElementById('wa-indent')            as HTMLInputElement).value  = String(cfg.indent);
    (document.getElementById('wa-indent-val')        as HTMLSpanElement).textContent = cfg.indent + 'em';
    (document.getElementById('wa-text-align')        as HTMLSelectElement).value = cfg.textAlign;
    (document.getElementById('wa-margin')            as HTMLInputElement).value  = String(cfg.margin);
    (document.getElementById('wa-margin-val')        as HTMLSpanElement).textContent = cfg.margin + 'cm';
  }

  // Bind genérico para cada control
  function bindControl(
    id: string, valId: string | null, suffix: string,
    transform?: (v: string) => string,
  ) {
    const el  = document.getElementById(id)!;
    const val = valId ? document.getElementById(valId) as HTMLSpanElement : null;
    el.addEventListener('input', () => {
      if (val) val.textContent = (transform ? transform((el as HTMLInputElement).value) : (el as HTMLInputElement).value) + suffix;
      applyTypo(readControls());
    });
  }

  bindControl('wa-font-family',  null,                 '');
  bindControl('wa-font-size',    'wa-font-size-val',    'pt');
  bindControl('wa-line-height',  'wa-line-height-val',  '',  v => parseFloat(v).toFixed(2));
  bindControl('wa-para-spacing', 'wa-para-spacing-val', 'em', v => parseFloat(v).toFixed(2));
  bindControl('wa-indent',       'wa-indent-val',       'em', v => parseFloat(v).toFixed(1));
  bindControl('wa-text-align',   null,                  '');
  bindControl('wa-margin',       'wa-margin-val',       'cm', v => parseFloat(v).toFixed(2));

  document.getElementById('wa-reset-btn')!.addEventListener('click', () => {
    setControls(DEFAULTS);
    applyTypo(DEFAULTS);
  });

  // Init
  setControls(DEFAULTS);
  applyTypo(DEFAULTS);
})();
</script>
