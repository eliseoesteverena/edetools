---
// src/pages/herramientas/whatsapp-imprimible.astro
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="WhatsApp Imprimible"
  description="Convertí texto con formato WhatsApp a HTML imprimible."
  icon="💬"
  mode="form"
  actionLabel="Ajustes"
  tags={[
    { label: 'impresión', type: 'print' },
    { label: 'client-side', type: 'web' },
  ]}
>
  <style id="wa-print-style"></style>

  <!-- Área principal: preview -->
  <div class="wa-main">
    <div id="wa-preview"></div>
  </div>

  <!-- Sidebar -->
  <div slot="sidebar" class="wa-sidebar">

    <div class="sb-section">
      <label class="sb-label" for="wa-input">Texto WhatsApp</label>
      <textarea id="wa-input" placeholder="Pegá el texto aquí…&#10;&#10;*negrita*  _cursiva_  ~tachado~  `código`&#10;--- = salto de página"></textarea>
      <p class="sb-hint">
        <code>*neg*</code> <code>_cur_</code> <code>~tach~</code>
        <code>`cod`</code> <code>```bloque```</code> <code>---</code>=salto
      </p>
    </div>

    <div class="sb-section">
      <label class="sb-label" for="wa-font-family">Fuente</label>
      <select id="wa-font-family">
        <option value="Roboto, sans-serif">Roboto</option>
        <option value="Georgia, serif">Georgia</option>
        <option value="'Times New Roman', serif">Times New Roman</option>
        <option value="Arial, sans-serif">Arial</option>
        <option value="'Courier New', monospace">Courier New</option>
        <option value="Garamond, serif">Garamond</option>
        <option value="Verdana, sans-serif">Verdana</option>
      </select>
    </div>

    <div class="sb-section">
      <label class="sb-label" for="wa-font-size">Tamaño <span class="sb-val" id="wa-font-size-val">11pt</span></label>
      <input type="range" id="wa-font-size" min="8" max="24" value="11" step="0.5" />
    </div>

    <div class="sb-section">
      <label class="sb-label" for="wa-line-height">Interlineado <span class="sb-val" id="wa-line-height-val">1.60</span></label>
      <input type="range" id="wa-line-height" min="1" max="3" value="1.6" step="0.05" />
    </div>

    <div class="sb-section">
      <label class="sb-label" for="wa-para-spacing">Esp. párrafo <span class="sb-val" id="wa-para-spacing-val">0.4em</span></label>
      <input type="range" id="wa-para-spacing" min="0" max="2" value="0.4" step="0.05" />
    </div>

    <div class="sb-section">
      <label class="sb-label" for="wa-indent">Sangría <span class="sb-val" id="wa-indent-val">0em</span></label>
      <input type="range" id="wa-indent" min="0" max="4" value="0" step="0.5" />
    </div>

    <div class="sb-section">
      <label class="sb-label" for="wa-text-align">Alineación</label>
      <select id="wa-text-align">
        <option value="left">Izquierda</option>
        <option value="justify">Justificado</option>
        <option value="center">Centrado</option>
        <option value="right">Derecha</option>
      </select>
    </div>

    <div class="sb-section">
      <label class="sb-label" for="wa-margin">Margen impresión <span class="sb-val" id="wa-margin-val">2cm</span></label>
      <input type="range" id="wa-margin" min="0.5" max="4" value="2" step="0.25" />
    </div>

    <div class="sb-actions">
      <button class="btn-reset" id="wa-reset-btn" type="button">↺ Restablecer</button>
      <button class="btn-print" id="wa-print-btn" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
          <rect x="6" y="14" width="12" height="8"/>
        </svg>
        Imprimir
      </button>
    </div>

  </div>

</ToolLayout>

<style>
  .wa-main { height: 100%; overflow-y: auto; background: var(--color-white); }

  #wa-preview {
    min-height: 100%;
    padding: var(--space-6);
    font-size: 11pt;
    line-height: 1.6;
    color: var(--color-gray-900);
  }

  #wa-preview:empty::before { content: 'El preview aparece aquí…'; color: var(--color-gray-500); font-style: italic; font-size: var(--font-sm); }
  #wa-preview p      { margin: 0 0 0.3em; }
  #wa-preview strong { font-weight: 700; }
  #wa-preview em     { font-style: italic; }
  #wa-preview s      { text-decoration: line-through; }

  #wa-preview code {
    font-family: monospace; font-size: 0.9em;
    background: var(--color-gray-100); border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-sm); padding: 1px 5px;
  }

  #wa-preview pre {
    font-family: monospace; font-size: 0.85em;
    background: var(--color-gray-50); border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md); padding: var(--space-3) var(--space-4);
    overflow-x: auto; margin: var(--space-2) 0; white-space: pre-wrap;
  }

  #wa-preview .page-break-marker {
    display: flex; align-items: center; gap: var(--space-2);
    margin: var(--space-3) 0; color: var(--color-gray-500);
    font-size: var(--font-xs); letter-spacing: 0.06em; text-transform: uppercase;
  }

  #wa-preview .page-break-marker::before,
  #wa-preview .page-break-marker::after { content: ''; flex: 1; border-top: 1px dashed var(--color-gray-200); }

  /* Sidebar */
  .wa-sidebar { display: flex; flex-direction: column; gap: 0; }

  .sb-section {
    display: flex; flex-direction: column; gap: var(--space-1);
    padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-gray-100);
    margin-bottom: var(--space-3);
  }

  .sb-section:last-child { border-bottom: none; margin-bottom: 0; }

  .sb-label {
    display: flex; justify-content: space-between; align-items: center;
    font-size: var(--font-xs); font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-gray-500); margin-bottom: 0;
  }

  .sb-val { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--color-primary); font-family: monospace; }

  .sb-hint { font-size: 0.6rem; color: var(--color-gray-500); line-height: 1.8; margin: 0; display: flex; flex-wrap: wrap; gap: 3px; }
  .sb-hint code { background: var(--color-gray-100); padding: 1px 4px; border-radius: var(--radius-sm); font-family: monospace; font-size: inherit; border: none; }

  #wa-input {
    width: 100%; min-height: 120px; resize: vertical;
    padding: var(--space-2) var(--space-3); border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md); background: var(--color-gray-50);
    font-family: monospace; font-size: var(--font-xs); line-height: 1.7;
    color: var(--color-gray-900); transition: border-color 0.2s;
  }

  #wa-input:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(26,26,46,0.08); }

  input[type="range"] {
    width: 100%; accent-color: var(--color-primary); cursor: pointer;
    padding: 0; border: none; background: none; box-shadow: none; height: 20px;
  }

  input[type="range"]:focus { box-shadow: none; outline: none; }

  .sb-actions { display: flex; gap: var(--space-2); padding-top: var(--space-2); }

  .btn-reset {
    flex: 1; padding: var(--space-2); background: var(--color-gray-100);
    color: var(--color-gray-700); border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md); font-size: var(--font-xs); font-family: inherit; cursor: pointer;
  }

  .btn-reset:hover { background: var(--color-gray-200); }

  .btn-print {
    flex: 2; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: var(--space-2); background: var(--color-primary); color: #fff;
    border: none; border-radius: var(--radius-md); font-size: var(--font-sm);
    font-weight: 500; font-family: inherit; cursor: pointer; transition: background 0.2s;
  }

  .btn-print:hover { background: var(--color-primary-dark); }

  @media print {
    .wa-main { overflow: visible !important; height: auto !important; }
    #wa-preview { border: none; padding: 0; color: #000; }
    #wa-preview .page-break-marker { display: block; visibility: hidden; height: 0; page-break-after: always; margin: 0; }
  }
</style>

<script>
(function () {
  const inputEl      = document.getElementById('wa-input')       as HTMLTextAreaElement;
  const previewEl    = document.getElementById('wa-preview')     as HTMLDivElement;
  const printStyleEl = document.getElementById('wa-print-style') as HTMLStyleElement;

  function escHtml(t: string) { return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function parseInline(t: string) {
    let s = escHtml(t);
    s = s.replace(/\*([^*\n]+)\*/g, '<strong>$1</strong>');
    s = s.replace(/_([^_\n]+)_/g,   '<em>$1</em>');
    s = s.replace(/~([^~\n]+)~/g,   '<s>$1</s>');
    s = s.replace(/`([^`\n]+)`/g,   '<code>$1</code>');
    return s;
  }

  function convertir(raw: string) {
    if (!raw.trim()) { previewEl.innerHTML = ''; return; }
    const lines = raw.split('\n');
    const out: string[] = [];
    let inCode = false, codeAcc: string[] = [];
    lines.forEach(line => {
      if (line.startsWith('```')) {
        if (!inCode) { inCode = true; codeAcc = []; }
        else { inCode = false; out.push('<pre>' + escHtml(codeAcc.join('\n')) + '</pre>'); codeAcc = []; }
        return;
      }
      if (inCode) { codeAcc.push(line); return; }
      if (/^\s*---\s*$/.test(line)) { out.push('<div class="page-break-marker">salto de página</div>'); return; }
      if (line.trim() === '') { out.push('<p>&nbsp;</p>'); return; }
      out.push('<p>' + parseInline(line) + '</p>');
    });
    if (inCode && codeAcc.length) out.push('<pre>' + escHtml(codeAcc.join('\n')) + '</pre>');
    previewEl.innerHTML = out.join('\n');
    applyTypo(readControls());
  }

  inputEl.addEventListener('input', () => convertir(inputEl.value));
  document.getElementById('wa-print-btn')!.addEventListener('click', () => { convertir(inputEl.value); window.print(); });

  const DEFAULTS = { fontFamily: 'Roboto, sans-serif', fontSize: 11, lineHeight: 1.6, paraSpacing: 0.4, indent: 0, textAlign: 'left', margin: 2 };

  function applyTypo(cfg: typeof DEFAULTS) {
    previewEl.style.fontFamily = cfg.fontFamily;
    previewEl.style.fontSize   = cfg.fontSize + 'pt';
    previewEl.style.lineHeight = String(cfg.lineHeight);
    previewEl.style.textAlign  = cfg.textAlign;
    previewEl.querySelectorAll('p').forEach(p => {
      (p as HTMLElement).style.marginBottom = cfg.paraSpacing + 'em';
      (p as HTMLElement).style.textIndent   = cfg.indent + 'em';
    });
    printStyleEl.textContent = `@media print { @page { margin: ${cfg.margin}cm; } #wa-preview p { font-family: ${cfg.fontFamily}; font-size: ${cfg.fontSize}pt; line-height: ${cfg.lineHeight}; margin-bottom: ${cfg.paraSpacing}em; text-indent: ${cfg.indent}em; text-align: ${cfg.textAlign}; } }`;
  }

  function readControls(): typeof DEFAULTS {
    return {
      fontFamily:  (document.getElementById('wa-font-family') as HTMLSelectElement).value,
      fontSize:    parseFloat((document.getElementById('wa-font-size') as HTMLInputElement).value),
      lineHeight:  parseFloat((document.getElementById('wa-line-height') as HTMLInputElement).value),
      paraSpacing: parseFloat((document.getElementById('wa-para-spacing') as HTMLInputElement).value),
      indent:      parseFloat((document.getElementById('wa-indent') as HTMLInputElement).value),
      textAlign:   (document.getElementById('wa-text-align') as HTMLSelectElement).value,
      margin:      parseFloat((document.getElementById('wa-margin') as HTMLInputElement).value),
    };
  }

  function setControls(cfg: typeof DEFAULTS) {
    (document.getElementById('wa-font-family')      as HTMLSelectElement).value = cfg.fontFamily;
    (document.getElementById('wa-font-size')        as HTMLInputElement).value  = String(cfg.fontSize);
    (document.getElementById('wa-font-size-val')    as HTMLSpanElement).textContent = cfg.fontSize + 'pt';
    (document.getElementById('wa-line-height')      as HTMLInputElement).value  = String(cfg.lineHeight);
    (document.getElementById('wa-line-height-val')  as HTMLSpanElement).textContent = cfg.lineHeight.toFixed(2);
    (document.getElementById('wa-para-spacing')     as HTMLInputElement).value  = String(cfg.paraSpacing);
    (document.getElementById('wa-para-spacing-val') as HTMLSpanElement).textContent = cfg.paraSpacing + 'em';
    (document.getElementById('wa-indent')           as HTMLInputElement).value  = String(cfg.indent);
    (document.getElementById('wa-indent-val')       as HTMLSpanElement).textContent = cfg.indent + 'em';
    (document.getElementById('wa-text-align')       as HTMLSelectElement).value = cfg.textAlign;
    (document.getElementById('wa-margin')           as HTMLInputElement).value  = String(cfg.margin);
    (document.getElementById('wa-margin-val')       as HTMLSpanElement).textContent = cfg.margin + 'cm';
  }

  function bindControl(id: string, valId: string | null, suffix: string, transform?: (v: string) => string) {
    const el  = document.getElementById(id)!;
    const val = valId ? document.getElementById(valId) as HTMLSpanElement : null;
    el.addEventListener('input', () => {
      if (val) val.textContent = (transform ? transform((el as HTMLInputElement).value) : (el as HTMLInputElement).value) + suffix;
      applyTypo(readControls());
    });
  }

  bindControl('wa-font-family',  null,                '');
  bindControl('wa-font-size',    'wa-font-size-val',   'pt');
  bindControl('wa-line-height',  'wa-line-height-val', '',  v => parseFloat(v).toFixed(2));
  bindControl('wa-para-spacing', 'wa-para-spacing-val','em', v => parseFloat(v).toFixed(2));
  bindControl('wa-indent',       'wa-indent-val',      'em', v => parseFloat(v).toFixed(1));
  bindControl('wa-text-align',   null,                 '');
  bindControl('wa-margin',       'wa-margin-val',      'cm', v => parseFloat(v).toFixed(2));

  document.getElementById('wa-reset-btn')!.addEventListener('click', () => { setControls(DEFAULTS); applyTypo(DEFAULTS); });
  setControls(DEFAULTS);
  applyTypo(DEFAULTS);
})();
</script>
