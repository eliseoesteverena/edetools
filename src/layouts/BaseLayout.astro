---
// src/layouts/BaseLayout.astro
// Layout raíz — rediseño inspirado en iLovePDF.
//
// Header con dos menús separados:
//   - Izquierda: hamburguesa → drawer con lista de herramientas por sección
//   - Derecha:   cuenta/auth (stub Auth0)
//
// Props:
//   title       – <title> de la página
//   description – meta description
//   toolPage    – muestra el nombre de la herramienta activa en el header

interface Props {
  title: string;
  description?: string;
  toolPage?: boolean;
  toolTitle?: string;
}

const {
  title,
  description = 'Herramientas para gráfica e impresión profesional.',
  toolPage = false,
  toolTitle = '',
} = Astro.props;

const currentPath = Astro.url.pathname;

// Lista de herramientas para el drawer de navegación
const tools = [
  {
    section: 'Impresión',
    items: [
      { href: '/herramientas/marcas-de-corte',    label: 'Marcas de corte',           icon: '✂️'  },
      { href: '/herramientas/fotos',              label: 'Fotos',                     icon: '🖼️' },
      { href: '/herramientas/recorte-etiquetas',  label: 'Recorte de etiquetas',      icon: '📦'  },
      { href: '/herramientas/whatsapp-imprimible',label: 'WhatsApp Imprimible',        icon: '💬'  },
      { href: '/herramientas/carta-documento',    label: 'Carta Documento',           icon: '📄'  },
    ],
  },
  {
    section: 'Archivos PDF',
    items: [
      { href: '/herramientas/contar-paginas',          label: 'Contar páginas',              icon: '🔢' },
      { href: '/herramientas/extractor-primera-pagina',label: 'Extractor de primera página', icon: '📑' },
      { href: '/herramientas/dividir-stickers',        label: 'Dividir stickers',            icon: '🪄' },
      { href: '/herramientas/recorte-etiquetas',       label: 'Recorte de etiquetas',        icon: '📦' },
    ],
  },
  {
    section: 'Email & Web',
    items: [
      { href: '/herramientas/eml-extractor', label: 'Extractor de EMLs', icon: '📧' },
      { href: '/herramientas/abrir-links',   label: 'Abrir links',       icon: '🔗' },
    ],
  },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} — edetools</title>
  <link rel="stylesheet" href="/m-2.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ── Shell ─────────────────────────────────────────── */
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--color-gray-50);
    }

    main { flex: 1; }

    /* ── HEADER ────────────────────────────────────────── */
    .site-header {
      background: var(--color-primary);
      border-bottom: 3px solid var(--color-accent);
      height: 52px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-inner {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
    }

    .header-left,
    .header-right {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    /* Botón hamburguesa */
    .btn-menu {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 36px;
      height: 36px;
      padding: 8px;
      background: transparent;
      border: none;
      cursor: pointer;
      border-radius: var(--radius-md);
      flex-shrink: 0;
      transition: background 0.15s;
    }

    .btn-menu:hover { background: rgba(255,255,255,0.08); }

    .btn-menu span {
      display: block;
      height: 2px;
      background: #ffffff;
      border-radius: 2px;
      transition: transform 0.2s, opacity 0.2s;
    }

    .btn-menu.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .btn-menu.open span:nth-child(2) { opacity: 0; }
    .btn-menu.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Marca */
    .brand {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      text-decoration: none;
    }

    .brand-name {
      font-size: var(--font-lg);
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.03em;
    }

    .brand-dot {
      width: 5px;
      height: 5px;
      background: var(--color-accent);
      border-radius: 50%;
      flex-shrink: 0;
      margin-bottom: -2px;
    }

    /* Nombre de herramienta activa (solo en tool pages) */
    .tool-name-badge {
      display: none;
      font-size: var(--font-xs);
      color: var(--color-gray-500);
      padding: 2px var(--space-2);
      border: 1px solid var(--color-gray-700);
      border-radius: var(--radius-sm);
      white-space: nowrap;
      max-width: 160px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    @media (min-width: 480px) {
      .tool-name-badge { display: inline-block; }
    }

    /* Nav links (solo desktop) */
    .header-nav {
      display: none;
      align-items: center;
      gap: var(--space-4);
    }

    @media (min-width: 768px) {
      .header-nav { display: flex; }
    }

    .nav-link {
      font-size: var(--font-sm);
      color: var(--color-gray-500);
      text-decoration: none;
      transition: color 0.2s;
      padding: var(--space-1) 0;
      border-bottom: 2px solid transparent;
    }

    .nav-link:hover          { color: #ffffff; text-decoration: none; }
    .nav-link.active         { color: #ffffff; border-bottom-color: var(--color-accent); }

    /* Botón auth */
    .btn-auth {
      font-size: var(--font-sm);
      font-weight: 500;
      padding: var(--space-1) var(--space-3);
      background: transparent;
      border: 1px solid var(--color-gray-700);
      color: var(--color-gray-500);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
      white-space: nowrap;
    }

    .btn-auth:hover { border-color: #ffffff; color: #ffffff; background: transparent; }

    /* ── DRAWER DE HERRAMIENTAS ────────────────────────── */
    .drawer-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 90;
    }

    .drawer-overlay.open { display: block; }

    .drawer {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(320px, 85vw);
      background: var(--color-white);
      z-index: 95;
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .drawer.open { transform: translateX(0); }

    .drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-4);
      border-bottom: 1px solid var(--color-gray-200);
      background: var(--color-primary);
      flex-shrink: 0;
    }

    .drawer-title {
      font-size: var(--font-sm);
      font-weight: 600;
      color: #ffffff;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .btn-drawer-close {
      background: none;
      border: none;
      color: var(--color-gray-500);
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      padding: 2px 6px;
      border-radius: var(--radius-sm);
      font-family: inherit;
      transition: color 0.15s;
    }

    .btn-drawer-close:hover { color: #ffffff; background: none; }

    .drawer-body {
      flex: 1;
      overflow-y: auto;
      padding: var(--space-2) 0;
    }

    .drawer-section-title {
      font-size: var(--font-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-gray-500);
      padding: var(--space-3) var(--space-4) var(--space-1);
    }

    .drawer-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-2) var(--space-4);
      text-decoration: none;
      color: var(--color-gray-700);
      font-size: var(--font-sm);
      transition: background 0.15s, color 0.15s;
      border-left: 3px solid transparent;
    }

    .drawer-link:hover {
      background: var(--color-primary-light);
      color: var(--color-primary);
      text-decoration: none;
    }

    .drawer-link.active {
      background: var(--color-primary-light);
      color: var(--color-primary);
      border-left-color: var(--color-accent);
      font-weight: 500;
    }

    .drawer-link-icon {
      font-size: 1rem;
      flex-shrink: 0;
      width: 20px;
      text-align: center;
    }

    .drawer-footer {
      border-top: 1px solid var(--color-gray-200);
      padding: var(--space-3) var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      flex-shrink: 0;
    }

    .drawer-footer a {
      font-size: var(--font-xs);
      color: var(--color-gray-500);
      text-decoration: none;
    }

    .drawer-footer a:hover { color: var(--color-primary); text-decoration: none; }

    /* ── FOOTER ────────────────────────────────────────── */
    .site-footer {
      background: var(--color-primary);
      border-top: 3px solid var(--color-accent);
      padding: var(--space-6) 0;
      margin-top: auto;
    }

    .footer-inner {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--space-6);
    }

    .footer-brand-name {
      font-size: var(--font-base);
      font-weight: 700;
      color: #ffffff;
      margin-bottom: var(--space-1);
    }

    .footer-tagline {
      font-size: var(--font-xs);
      color: var(--color-gray-500);
      margin-bottom: 0;
    }

    .footer-links {
      display: flex;
      gap: var(--space-4);
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-links a {
      font-size: var(--font-xs);
      color: var(--color-gray-500);
      text-decoration: none;
    }

    .footer-links a:hover { color: #ffffff; text-decoration: none; }

    .footer-copy {
      font-size: var(--font-xs);
      color: var(--color-gray-700);
      margin-bottom: 0;
      margin-top: var(--space-4);
    }

    /* ── @media print ──────────────────────────────────── */
    @media print {
      .site-header,
      .drawer,
      .drawer-overlay,
      .site-footer {
        display: none !important;
      }

      body { background: #ffffff !important; min-height: unset; }
      main { flex: none; }
    }
  </style>
</head>
<body>

  <!-- ── HEADER ──────────────────────────────────────────── -->
  <header class="site-header">
    <div class="container">
      <div class="header-inner">

        <!-- Izquierda: hamburguesa + marca + tool badge -->
        <div class="header-left">
          <button class="btn-menu" id="btnMenu" type="button" aria-label="Menú de herramientas" aria-expanded="false" aria-controls="drawer">
            <span></span><span></span><span></span>
          </button>

          <a href="/" class="brand" aria-label="edetools — inicio">
            <span class="brand-name">edetools</span>
            <div class="brand-dot" aria-hidden="true"></div>
          </a>

          {toolPage && toolTitle && (
            <span class="tool-name-badge" aria-label={`Herramienta activa: ${toolTitle}`}>
              {toolTitle}
            </span>
          )}
        </div>

        <!-- Centro: nav desktop -->
        <nav class="header-nav" aria-label="Navegación principal">
          <a href="/" class:list={['nav-link', { active: currentPath === '/' }]}>Herramientas</a>
          <a href="/acerca" class:list={['nav-link', { active: currentPath.startsWith('/acerca') }]}>Acerca</a>
        </nav>

        <!-- Derecha: auth -->
        <div class="header-right">
          <button class="btn-auth" id="btn-auth" type="button">
            Iniciar sesión
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- ── DRAWER ──────────────────────────────────────────── -->
  <div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>

  <nav class="drawer" id="drawer" aria-label="Herramientas" aria-hidden="true">
    <div class="drawer-header">
      <span class="drawer-title">Herramientas</span>
      <button class="btn-drawer-close" id="btnDrawerClose" type="button" aria-label="Cerrar menú">&times;</button>
    </div>

    <div class="drawer-body">
      {tools.map(group => (
        <div>
          <p class="drawer-section-title">{group.section}</p>
          {group.items.map(item => (
            <a
              href={item.href}
              class:list={['drawer-link', { active: currentPath === item.href }]}
            >
              <span class="drawer-link-icon" aria-hidden="true">{item.icon}</span>
              {item.label}
            </a>
          ))}
        </div>
      ))}
    </div>

    <div class="drawer-footer">
      <a href="/acerca">Acerca de edetools</a>
      <a href="/privacidad">Privacidad</a>
      <a href="/contacto">Contacto</a>
    </div>
  </nav>

  <!-- ── CONTENIDO ───────────────────────────────────────── -->
  <main>
    <slot />
  </main>

  <!-- ── FOOTER ──────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <div>
          <p class="footer-brand-name">edetools</p>
          <p class="footer-tagline">Herramientas para gráfica e impresión profesional.</p>
        </div>
        <nav aria-label="Links del pie">
          <ul class="footer-links">
            <li><a href="/">Herramientas</a></li>
            <li><a href="/acerca">Acerca</a></li>
            <li><a href="/privacidad">Privacidad</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </nav>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} edetools — uso profesional</p>
    </div>
  </footer>

  <script>
    // ── Drawer ─────────────────────────────────────────────
    const btnMenu        = document.getElementById('btnMenu')        as HTMLButtonElement;
    const btnDrawerClose = document.getElementById('btnDrawerClose') as HTMLButtonElement;
    const drawer         = document.getElementById('drawer')         as HTMLElement;
    const drawerOverlay  = document.getElementById('drawerOverlay')  as HTMLDivElement;

    function openDrawer() {
      drawer.classList.add('open');
      drawerOverlay.classList.add('open');
      btnMenu.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      drawerOverlay.setAttribute('aria-hidden', 'false');
      btnMenu.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('open');
      drawerOverlay.classList.remove('open');
      btnMenu.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      drawerOverlay.setAttribute('aria-hidden', 'true');
      btnMenu.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    btnMenu.addEventListener('click',        () => drawer.classList.contains('open') ? closeDrawer() : openDrawer());
    btnDrawerClose.addEventListener('click', closeDrawer);
    drawerOverlay.addEventListener('click',  closeDrawer);

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

    // ── Auth stub ──────────────────────────────────────────
    document.getElementById('btn-auth')?.addEventListener('click', () => {
      console.info('[Auth] loginWithRedirect() — pendiente de configurar Auth0');
    });
  </script>

</body>
</html>
