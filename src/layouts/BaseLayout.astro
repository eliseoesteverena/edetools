---
// src/layouts/BaseLayout.astro
// Layout raíz compartido por todas las páginas de edetools.
// Props:
//   title       – <title> de la página
//   description – meta description (opcional)
//   toolPage    – boolean: si es true muestra breadcrumb "← Herramientas"

interface Props {
  title: string;
  description?: string;
  toolPage?: boolean;
}

const {
  title,
  description = 'Herramientas para gráfica e impresión profesional.',
  toolPage = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} — edetools</title>

  <!-- Framework CSS propio -->
  <link rel="stylesheet" href="/m-2.min.css" />

  <!-- Google Fonts: Roboto (requerido por m-2) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Estilos globales del layout -->
  <style>
    /* ── Layout shell ─────────────────────────────────── */
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--color-gray-50);
    }

    main { flex: 1; }

    /* ── HEADER ───────────────────────────────────────── */
    .site-header {
      background: var(--color-primary);
      border-bottom: 3px solid var(--color-accent);
      padding: var(--space-4) 0;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    /* Brand */
    .brand {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
    }

    .brand-name {
      font-size: var(--font-xl);
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.03em;
    }

    .brand-dot {
      width: 6px;
      height: 6px;
      background: var(--color-accent);
      border-radius: 50%;
      flex-shrink: 0;
      margin-bottom: -2px;
    }

    /* Nav links */
    .header-nav {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }

    .nav-link {
      font-size: var(--font-sm);
      color: var(--color-gray-500);
      text-decoration: none;
      transition: color 0.2s;
      padding: var(--space-1) 0;
      border-bottom: 2px solid transparent;
    }

    .nav-link:hover {
      color: #ffffff;
      text-decoration: none;
    }

    .nav-link.active {
      color: #ffffff;
      border-bottom-color: var(--color-accent);
    }

    /* Auth button */
    .btn-auth {
      font-size: var(--font-sm);
      font-weight: 500;
      padding: var(--space-1) var(--space-3);
      background: transparent;
      border: 1px solid var(--color-gray-700);
      color: var(--color-gray-500);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }

    .btn-auth:hover {
      border-color: #ffffff;
      color: #ffffff;
      background: transparent;
    }

    /* Breadcrumb en páginas de herramienta */
    .breadcrumb-bar {
      background: var(--color-surface, #fff);
      border-bottom: 1px solid var(--color-gray-200);
      padding: var(--space-2) 0;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--font-xs);
      color: var(--color-gray-500);
    }

    .breadcrumb a {
      color: var(--color-gray-500);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .breadcrumb a:hover { color: var(--color-primary); text-decoration: none; }
    .breadcrumb-sep { opacity: 0.4; }
    .breadcrumb-current { color: var(--color-gray-900); font-weight: 500; }

    /* ── FOOTER ───────────────────────────────────────── */
    .site-footer {
      background: var(--color-primary);
      border-top: 3px solid var(--color-accent);
      padding: var(--space-6) 0;
      margin-top: auto;
    }

    .footer-inner {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--space-6);
    }

    .footer-brand-name {
      font-size: var(--font-base);
      font-weight: 700;
      color: #ffffff;
      margin-bottom: var(--space-1);
    }

    .footer-tagline {
      font-size: var(--font-xs);
      color: var(--color-gray-500);
      margin-bottom: 0;
    }

    .footer-links {
      display: flex;
      gap: var(--space-4);
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-links a {
      font-size: var(--font-xs);
      color: var(--color-gray-500);
      text-decoration: none;
    }

    .footer-links a:hover { color: #ffffff; text-decoration: none; }

    .footer-copy {
      font-size: var(--font-xs);
      color: var(--color-gray-700);
      margin-bottom: 0;
      margin-top: var(--space-4);
    }
  </style>
</head>
<body>

  <!-- ── HEADER ─────────────────────────────────────────── -->
  <header class="site-header">
    <div class="container">
      <div class="header-inner">

        <a href="/" class="brand" aria-label="edetools — inicio">
          <span class="brand-name">edetools</span>
          <div class="brand-dot" aria-hidden="true"></div>
        </a>

        <nav class="header-nav" aria-label="Navegación principal">
          <a
            href="/"
            class:list={['nav-link', { active: currentPath === '/' }]}
          >Herramientas</a>
          <a
            href="/acerca"
            class:list={['nav-link', { active: currentPath.startsWith('/acerca') }]}
          >Acerca</a>

          <!--
            AUTH0 — reemplazar este botón con el componente Auth cuando esté configurado.
            Patrón: mostrar "Iniciar sesión" si no hay sesión, "usuario@mail / Salir" si la hay.
            Ver: https://auth0.com/docs/libraries/auth0-spa-js
          -->
          <button class="btn-auth" id="btn-auth" type="button">
            Iniciar sesión
          </button>
        </nav>

      </div>
    </div>
  </header>

  <!-- ── BREADCRUMB (solo en páginas de herramienta) ────── -->
  {toolPage && (
    <div class="breadcrumb-bar">
      <div class="container">
        <nav class="breadcrumb" aria-label="Ubicación">
          <a href="/">
            <span aria-hidden="true">←</span>
            Herramientas
          </a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span class="breadcrumb-current">
            <slot name="breadcrumb" />
          </span>
        </nav>
      </div>
    </div>
  )}

  <!-- ── CONTENIDO DE LA PÁGINA ─────────────────────────── -->
  <main>
    <slot />
  </main>

  <!-- ── FOOTER ─────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <div>
          <p class="footer-brand-name">edetools</p>
          <p class="footer-tagline">Herramientas para gráfica e impresión profesional.</p>
        </div>
        <nav aria-label="Links del pie">
          <ul class="footer-links">
            <li><a href="/">Herramientas</a></li>
            <li><a href="/acerca">Acerca</a></li>
            <li><a href="/privacidad">Privacidad</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </nav>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} edetools — uso profesional</p>
    </div>
  </footer>

  <!--
    AUTH0 SCRIPT STUB
    Cuando estés listo para integrar Auth0:
    1. npm install @auth0/auth0-spa-js
    2. Crear src/lib/auth.ts con el cliente Auth0
    3. Reemplazar este script con la lógica real
  -->
  <script>
    // Stub: simula estado de auth para desarrollo
    // En producción: reemplazar con auth0-spa-js
    const btnAuth = document.getElementById('btn-auth');
    if (btnAuth) {
      btnAuth.addEventListener('click', () => {
        console.info('[Auth] loginWithRedirect() — pendiente de configurar Auth0');
      });
    }
  </script>

</body>
</html>
