---
// src/components/ToolCard.astro
// Tarjeta de herramienta para el hub principal.
//
// Props:
//   href        – URL de la herramienta (si está lista)
//   title       – nombre de la herramienta
//   description – descripción corta
//   icon        – emoji o carácter
//   status      – 'live' | 'dev' | 'pending'
//   tags        – array de { label, type }  type: 'print'|'pdf'|'img'|'web'|'email'|'python'|'php'|'local'
//   pro         – boolean: muestra badge PRO

interface Tag {
  label: string;
  type: 'print' | 'pdf' | 'img' | 'web' | 'email' | 'python' | 'php' | 'local';
}

interface Props {
  href?: string;
  title: string;
  description: string;
  icon: string;
  status?: 'live' | 'dev' | 'pending';
  tags?: Tag[];
  pro?: boolean;
}

const {
  href,
  title,
  description,
  icon,
  status = 'pending',
  tags = [],
  pro = false,
} = Astro.props;

const statusLabel = { live: 'Disponible', dev: 'En desarrollo', pending: 'Próximamente' }[status];
const isClickable = status === 'live' && !!href;

// Contenido interno compartido — se reutiliza en ambas ramas
---

{/* Tarjeta clicable: usa <a> */}
{isClickable ? (
  <a
    href={href}
    class="tool-card tool-card--live"
    aria-label={title}
  >
    {pro && <span class="card-badge-pro" aria-label="Herramienta Pro">PRO</span>}
    <div class="card-header">
      <span class="card-icon" aria-hidden="true">{icon}</span>
      <span class:list={['card-status', `card-status--${status}`]}>{statusLabel}</span>
    </div>
    <p class="card-title">{title}</p>
    <p class="card-desc">{description}</p>
    {tags.length > 0 && (
      <ul class="card-tags" aria-label="Categorías">
        {tags.map(t => (
          <li class:list={['tag', `tag--${t.type}`]}>{t.label}</li>
        ))}
      </ul>
    )}
  </a>
) : (
  <div class="tool-card tool-card--disabled">
    {pro && <span class="card-badge-pro" aria-label="Herramienta Pro">PRO</span>}
    <div class="card-header">
      <span class="card-icon" aria-hidden="true">{icon}</span>
      <span class:list={['card-status', `card-status--${status}`]}>{statusLabel}</span>
    </div>
    <p class="card-title">{title}</p>
    <p class="card-desc">{description}</p>
    {tags.length > 0 && (
      <ul class="card-tags" aria-label="Categorías">
        {tags.map(t => (
          <li class:list={['tag', `tag--${t.type}`]}>{t.label}</li>
        ))}
      </ul>
    )}
  </div>
)}

<style>
  .tool-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    color: inherit;
    text-decoration: none;
  }

  .tool-card--live {
    cursor: pointer;
  }

  .tool-card--live:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 20px rgba(26, 26, 46, 0.1);
    transform: translateY(-2px);
    text-decoration: none;
    color: inherit;
  }

  .tool-card--disabled {
    opacity: 0.6;
    cursor: default;
  }

  /* PRO badge */
  .card-badge-pro {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.15rem 0.4rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-sm);
  }

  /* Header: icon + status */
  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .card-icon { font-size: 1.5rem; line-height: 1; }

  .card-status {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid;
    flex-shrink: 0;
  }

  .card-status--live    { color: #166534; background: #dcfce7; border-color: #86efac; }
  .card-status--dev     { color: #92400e; background: #fef3c7; border-color: #fcd34d; }
  .card-status--pending { color: var(--color-gray-500); background: var(--color-gray-100); border-color: var(--color-gray-200); }

  /* Title & desc */
  .card-title {
    font-size: var(--font-base);
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: 0;
    line-height: 1.3;
  }

  .card-desc {
    font-size: var(--font-sm);
    color: var(--color-gray-500);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 0;
  }

  /* Tags */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .tag--print  { background: #dcfce7; color: #166534; }
  .tag--pdf    { background: #fdecea; color: #991b1b; }
  .tag--img    { background: #ede9fe; color: #5b21b6; }
  .tag--web    { background: #dbeafe; color: #1e40af; }
  .tag--email  { background: #fef3c7; color: #92400e; }
  .tag--python { background: #fef9c3; color: #713f12; }
  .tag--php    { background: #f3e8ff; color: #6b21a8; }
  .tag--local  { background: var(--color-gray-100); color: var(--color-gray-700); }
</style>
